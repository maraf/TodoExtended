{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../artifacts/todoextended.db"
  },
  "Demo": {
    "Enabled": false
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "consumers",
    "ClientId": "<see appsettings.local.json>",
    "ClientSecret": "<see appsettings.local.json>",
    "CallbackPath": "/signin-oidc"
  },
  "Graph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": [ "Tasks.ReadWrite", "User.Read", "MailboxSettings.Read" ]
  },
  "TodoCache": {
    "StalenessThresholdMinutes": 0,
    "EnableBackgroundSync": true,
    "SoftDeleteRetentionDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning",
      "TodoExtended": "Debug"
    }
  },
  "AllowedHosts": "*"
}
