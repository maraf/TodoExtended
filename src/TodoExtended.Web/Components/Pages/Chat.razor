@page "/chat"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.AI
@using Microsoft.Extensions.AI
@implements IDisposable
@inject IChatService ChatService
@inject ILoggerFactory LoggerFactory

<PageTitle>AI Chat</PageTitle>

<PageHeader Title="AI Chat" FromColor="from-violet-500" ToColor="to-fuchsia-500" ShadowColor="shadow-violet-500/20">
    <Icon>
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
    </Icon>
</PageHeader>

<AgentBoundary Agent="_agent" @key="_agent">
    <TaskChatWorkspace Client="_client" Thread="_thread" OnReset="Reset">
        <MessageList>
            <Footer Context="agentContext">
                @* The workspace renders status and retry controls. *@
            </Footer>
            <EmptyContent>
                <div class="text-center py-12 px-4">
                    <h2 class="text-lg font-bold text-slate-700 dark:text-slate-200 mb-2">Chat with your tasks</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        Plan your day, find tasks, or ask for changes. Nothing changes until you approve it.
                    </p>
                </div>
            </EmptyContent>
            <ChildContent>
                <BlockRenderer TBlock="RichContentBlock">
                    <ChatMessageBubble Message="@(new Services.AiChat.ChatMessage(
                        context.Role == ChatRole.User ? "user" : "assistant",
                        context.RawText, null, _thread.GetTimestamp(context)))" />
                </BlockRenderer>
                <BlockRenderer TBlock="UIActionBlock" Context="action">
                    <TaskActionReview Block="action" Client="_client" />
                </BlockRenderer>
                <BlockRenderer TBlock="FunctionInvocationContentBlock" Context="action"
                               When="@(block => block.ToolName == TaskAgentChatClient.ReviewToolName)">
                    <ProposedActionCard Action="@TaskAgentChatClient.ReadAction(action.Arguments)"
                                        IsRestored="true"
                                        Result="@(action.Result is { } result ? TaskAgentChatClient.ReadResult(result.Result) : null)" />
                </BlockRenderer>
            </ChildContent>
        </MessageList>
    </TaskChatWorkspace>
</AgentBoundary>

@code {
    private UIAgent _agent = default!;
    private TaskAgentChatClient _client = default!;
    private BrowserConversationThread _thread = default!;

    protected override void OnInitialized()
    {
        _client = new TaskAgentChatClient(ChatService);
        CreateAgent();
    }

    private void CreateAgent()
    {
        _thread = new BrowserConversationThread();
        _agent = new UIAgent(_client, options =>
        {
            options.Thread = _thread;
            options.AddBlockHandler(new ChatTimestampHandler(_thread));
            options.RegisterUIAction(AIFunctionFactory.Create(
                _client.ReviewActionAsync,
                name: TaskAgentChatClient.ReviewToolName,
                description: "Review a proposed task change. The user must explicitly approve or reject it."));
        }, LoggerFactory);
    }

    private void Reset()
    {
        _agent.Dispose();
        _client.ClearPending();
        CreateAgent();
    }

    public void Dispose()
    {
        _agent.Dispose();
        _client.Dispose();
    }
}
