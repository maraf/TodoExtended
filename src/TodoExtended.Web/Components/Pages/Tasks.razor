@page "/tasks/{ListId?}"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject INotificationService Notifications

<PageTitle>Tasks</PageTitle>

<SectionContent SectionName="page-header">
    <div class="flex items-center gap-3">
        <div class="hidden sm:flex w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-brand-600 items-center justify-center shadow-lg shadow-brand-500/20 flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
        </div>
        <h1 class="text-lg font-bold text-white tracking-tight">Tasks</h1>
    </div>
</SectionContent>

@if (_error is not null)
{
    <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-5 py-4 text-sm font-medium">⚠ @_error</div>
}
else if (ListId is null)
{
    <div class="flex flex-col items-center justify-center min-h-[40vh] text-center">
        <div class="text-6xl mb-5">📋</div>
        <h2 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">Pick a list</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Select a task list from the sidebar to get started.</p>
    </div>
}
else
{
    <!-- Stats chips -->
    @if (TaskItems is { Count: > 0 })
    {
        <div class="flex items-center gap-2 mb-6">
            <span class="chip chip-primary">@TaskItems.Count(t => !t.IsCompleted) open</span>
            @if (TaskItems.Any(t => t.IsCompleted))
            {
                <span class="chip chip-success">@TaskItems.Count(t => t.IsCompleted) done</span>
            }
            <button @onclick="() => _hideCompleted = !_hideCompleted"
                    class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 flex items-center gap-1 transition-colors ml-auto">
                @if (_hideCompleted)
                {
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                    </svg>
                    <span>Show completed</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    <span>Hide completed</span>
                }
            </button>
        </div>
    }

    @if (_loadingTasks)
    {
        <div class="card dark:bg-slate-800 dark:border-slate-700 overflow-hidden">
            <div class="h-1 bg-gradient-to-r from-violet-500 via-brand-500 to-sky-500 animate-pulse"></div>
            @for (int i = 0; i < 5; i++)
            {
                <div class="task-row">
                    <div class="w-5 h-5 rounded bg-slate-200 dark:bg-slate-700 flex-shrink-0 animate-pulse"></div>
                    <div class="flex-1 h-4 bg-slate-100 dark:bg-slate-700 rounded-full animate-pulse"></div>
                </div>
            }
        </div>
    }
    else if (TaskItems!.Count == 0)
    {
        <div class="card dark:bg-slate-800 dark:border-slate-700 flex flex-col items-center justify-center py-20 text-center">
            <div class="text-5xl mb-4">✅</div>
            <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">Empty list</h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm">No tasks in this list yet.</p>
        </div>
    }
    else
    {
        <div class="card dark:bg-slate-800 dark:border-slate-700 overflow-hidden">
            @{
                var pct = TaskItems!.Count > 0 ? (int)(100.0 * TaskItems!.Count(t => t.IsCompleted) / TaskItems!.Count) : 0;
                var visibleTasks = _hideCompleted ? TaskItems!.Where(t => !t.IsCompleted).ToList() : TaskItems!.ToList();
            }
            <div class="h-1.5 bg-slate-100 dark:bg-slate-700">
                <div class="h-full bg-gradient-to-r from-violet-500 to-brand-500 rounded-r-full transition-all duration-500" style="width: @(pct)%"></div>
            </div>

            @if (visibleTasks.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-12 text-center">
                    <div class="text-4xl mb-3">✅</div>
                    <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">All tasks completed!</p>
                    <button @onclick="() => _hideCompleted = false" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">Show completed tasks</button>
                </div>
            }
            else
            {
                @foreach (var task in visibleTasks)
                {
                    <div class="task-row @(task.IsCompleted ? "opacity-50" : "")">
                        <TaskStatusCheckbox TaskId="@task.Id"
                                            ListId="@ListId"
                                            IsCompleted="@task.IsCompleted"
                                            TaskTitle="@task.Title"
                                            OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                            OnError="(msg) => Notifications.Add(msg, NotifySeverity.Warning)" />
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-200 @(task.IsCompleted ? "line-through text-slate-400 dark:text-slate-500" : "") truncate">
                                @task.Title
                            </p>
                            @if (task.DueDate is not null)
                            {
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    @task.DueDate.Value.ToString("MMM d, yyyy")
                                </p>
                            }
                        </div>
                        @if (task.Importance == "High")
                        {
                            <span class="chip chip-error flex-shrink-0" title="High priority">!</span>
                        }
                    </div>
                }
            }
        </div>
    }
}

@code {
    [Parameter]
    public string? ListId { get; set; }

    [PersistentState]
    public IReadOnlyList<PersistedTodoTask>? TaskItems { get; set; }

    [PersistentState]
    public string? PersistedListId { get; set; }

    private bool _loadingTasks;
    private bool _hideCompleted = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (ListId is null)
        {
            TaskItems = null;
            PersistedListId = null;
            return;
        }

        if (TaskItems is not null && PersistedListId == ListId)
        {
            _loadingTasks = false;
            return;
        }

        _loadingTasks = true;
        _error = null;
        _hideCompleted = true;
        TaskItems = null;

        try
        {
            TaskItems = (await TodoService.GetTasksAsync(ListId))
                .Select(t => new PersistedTodoTask(t.Id, t.Title, t.IsCompleted, t.DueDate, t.Importance))
                .ToList();
            PersistedListId = ListId;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load tasks: {ex.Message}";
        }
        finally
        {
            _loadingTasks = false;
        }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        TaskItems = TaskItems?.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }
}
