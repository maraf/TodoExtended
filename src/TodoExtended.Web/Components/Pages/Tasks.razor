@page "/tasks"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager

<PageTitle>My Tasks</PageTitle>

<Heading Tag="HeadingTag.H1" class="mb-6">My Tasks</Heading>

@if (_loading)
{
    <div class="flex items-center gap-2">
        <Spinner Size="SpinnerSize.Sm" Color="SpinnerColor.Info" />
        <span class="text-gray-500 dark:text-gray-400">Loading task lists...</span>
    </div>
}
else if (_error is not null)
{
    <Alert Color="AlertColor.Failure">
        <CustomContent>@_error</CustomContent>
    </Alert>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
            <Heading Tag="HeadingTag.H4" class="mb-3">Task Lists</Heading>
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm dark:bg-gray-800 dark:border-gray-700 divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var list in TaskLists)
                {
                    <div class="flex items-center px-4 py-3 cursor-pointer transition-colors @(list.Id == _selectedListId ? "bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500" : "hover:bg-gray-50 dark:hover:bg-gray-700")"
                         @onclick="() => SelectList(list.Id)">
                        <span class="flex-1 text-sm @(list.Id == _selectedListId ? "font-semibold text-blue-700 dark:text-blue-400" : "text-gray-900 dark:text-white")">@list.DisplayName</span>
                        @if (_archivingListId == list.Id)
                        {
                            <Spinner Size="SpinnerSize.Xs" Color="SpinnerColor.Gray" />
                        }
                        else
                        {
                            <button class="text-xs text-gray-400 hover:text-red-600 dark:hover:text-red-400 ml-2"
                                    @onclick="() => ArchiveList(list.Id)" @onclick:stopPropagation="true"
                                    title="Archive list">
                                Archive
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="mt-4">
                <button class="w-full flex items-center justify-between px-3 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
                        @onclick="ToggleArchivedSection">
                    <span>Archived</span>
                    <span class="text-xs">@(_showArchived ? "▲" : "▼")</span>
                </button>

                @if (_showArchived)
                {
                    @if (_loadingArchived)
                    {
                        <div class="flex items-center gap-2 mt-3 px-2">
                            <Spinner Size="SpinnerSize.Xs" Color="SpinnerColor.Gray" />
                            <span class="text-sm text-gray-500 dark:text-gray-400">Loading archived lists...</span>
                        </div>
                    }
                    else if (_archivedLists.Count == 0)
                    {
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-3 px-2">No archived lists.</p>
                    }
                    else
                    {
                        <div class="bg-white rounded-lg border border-gray-200 shadow-sm dark:bg-gray-800 dark:border-gray-700 divide-y divide-gray-200 dark:divide-gray-700 mt-2">
                            @foreach (var list in _archivedLists)
                            {
                                <div class="flex items-center px-4 py-3">
                                    <span class="flex-1 text-sm text-gray-500 dark:text-gray-400">@list.DisplayName</span>
                                    @if (_archivingListId == list.Id)
                                    {
                                        <Spinner Size="SpinnerSize.Xs" Color="SpinnerColor.Gray" />
                                    }
                                    else
                                    {
                                        <button class="text-xs text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 ml-2"
                                                @onclick="() => UnarchiveList(list.Id)"
                                                title="Restore list">
                                            Restore
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="md:col-span-2">
            @if (_selectedListId is not null)
            {
                @if (_loadingTasks)
                {
                    <div class="flex items-center gap-2">
                        <Spinner Size="SpinnerSize.Sm" Color="SpinnerColor.Info" />
                        <span class="text-gray-500 dark:text-gray-400">Loading tasks...</span>
                    </div>
                }
                else
                {
                    <Heading Tag="HeadingTag.H4" class="mb-3">@TaskLists.FirstOrDefault(l => l.Id == _selectedListId)?.DisplayName</Heading>

                    @if (_toggleError is not null)
                    {
                        <Alert Color="AlertColor.Warning" class="mb-4">
                            <CustomContent>
                                <div class="flex items-center justify-between">
                                    <span>@_toggleError</span>
                                    <button class="ml-4 text-sm font-medium hover:opacity-75" @onclick="() => _toggleError = null">✕</button>
                                </div>
                            </CustomContent>
                        </Alert>
                    }

                    @if (_tasks.Count == 0)
                    {
                        <Paragraph class="text-gray-500 dark:text-gray-400">No tasks in this list.</Paragraph>
                    }
                    else
                    {
                        <div class="bg-white rounded-lg border border-gray-200 shadow-sm dark:bg-gray-800 dark:border-gray-700 divide-y divide-gray-200 dark:divide-gray-700">
                            @foreach (var task in _tasks)
                            {
                                <div class="flex items-center px-4 py-3">
                                    <TaskStatusCheckbox TaskId="@task.Id"
                                                        ListId="@(_selectedListId!)"
                                                        IsCompleted="@task.IsCompleted"
                                                        TaskTitle="@task.Title"
                                                        OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                                        OnError="(msg) => _toggleError = msg" />
                                    <div class="flex-1">
                                        <span class="@(task.IsCompleted ? "line-through text-gray-400 dark:text-gray-500" : "text-gray-900 dark:text-white")">
                                            @task.Title
                                        </span>
                                        @if (task.DueDate is not null)
                                        {
                                            <span class="text-sm text-gray-500 dark:text-gray-400 ml-2">Due: @task.DueDate.Value.ToString("MMM d, yyyy")</span>
                                        }
                                        @if (task.Importance == "High")
                                        {
                                            <Badge Color="BadgeColor.Pink" class="ml-2">!</Badge>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            }
            else
            {
                <Paragraph class="text-gray-500 dark:text-gray-400">Select a task list to view tasks.</Paragraph>
            }
        </div>
    </div>
}

@code {
    [PersistentState]
    public IReadOnlyList<TodoTaskList>? TaskLists { get; set; }

    private IReadOnlyList<TodoTask> _tasks = [];
    private string? _selectedListId;
    private bool _loading = true;
    private bool _loadingTasks;
    private string? _error;
    private string? _toggleError;

    private IReadOnlyList<TodoTaskList> _archivedLists = [];
    private bool _showArchived;
    private bool _loadingArchived;
    private bool _archivedListsLoaded;
    private string? _archivingListId;

    protected override async Task OnInitializedAsync()
    {
        if (TaskLists is not null)
        {
            _loading = false;
            return;
        }

        try
        {
            TaskLists = await TodoService.GetTaskListsAsync();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load task lists: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectList(string listId)
    {
        _selectedListId = listId;
        _loadingTasks = true;
        _tasks = [];

        try
        {
            _tasks = await TodoService.GetTasksAsync(listId);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load tasks: {ex.Message}";
        }
        finally
        {
            _loadingTasks = false;
        }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        _toggleError = null;
        _tasks = _tasks.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }

    private async Task ToggleArchivedSection()
    {
        _showArchived = !_showArchived;

        if (_showArchived && !_archivedListsLoaded)
        {
            _loadingArchived = true;
            try
            {
                _archivedLists = await TodoService.GetArchivedTaskListsAsync();
                _archivedListsLoaded = true;
            }
            catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
            {
                NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
                return;
            }
            catch (Exception ex)
            {
                _error = $"Failed to load archived lists: {ex.Message}";
            }
            finally
            {
                _loadingArchived = false;
            }
        }
    }

    private async Task ArchiveList(string listId)
    {
        if (_archivingListId is not null) return;
        _archivingListId = listId;

        try
        {
            await TodoService.SetTaskListArchivedAsync(listId, true);

            var list = TaskLists!.First(l => l.Id == listId);
            TaskLists = TaskLists!.Where(l => l.Id != listId).ToList();
            _archivedLists = [.. _archivedLists, list with { IsArchived = true }];

            if (_selectedListId == listId)
            {
                _selectedListId = null;
                _tasks = [];
            }
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to archive list: {ex.Message}";
        }
        finally
        {
            _archivingListId = null;
        }
    }

    private async Task UnarchiveList(string listId)
    {
        if (_archivingListId is not null) return;
        _archivingListId = listId;

        try
        {
            await TodoService.SetTaskListArchivedAsync(listId, false);

            var list = _archivedLists.First(l => l.Id == listId);
            _archivedLists = _archivedLists.Where(l => l.Id != listId).ToList();
            TaskLists = [.. TaskLists!, list with { IsArchived = false }];
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to unarchive list: {ex.Message}";
        }
        finally
        {
            _archivingListId = null;
        }
    }
}
