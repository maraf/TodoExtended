@page "/tasks/{ListId?}"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Tasks</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Tasks</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="pa-4">
        @if (ListId is not null)
        {
            @if (_loadingTasks)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else
            {
                <MudText Typo="Typo.h5" Class="mb-2">@_listDisplayName</MudText>
                <MudDivider Class="mb-4" />

                @if (_tasks.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No tasks in this list.</MudAlert>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var task in _tasks)
                        {
                            <MudListItem T="string">
                                <div class="d-flex align-center" style="width:100%">
                                    <TaskStatusCheckbox TaskId="@task.Id"
                                                        ListId="@ListId"
                                                        IsCompleted="@task.IsCompleted"
                                                        TaskTitle="@task.Title"
                                                        OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                                        OnError="(msg) => Snackbar.Add(msg, Severity.Warning)" />
                                    <div>
                                        <MudText Style="@(task.IsCompleted ? "text-decoration: line-through; opacity: 0.5;" : "")">
                                            @task.Title
                                        </MudText>
                                        @if (task.DueDate is not null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Due: @task.DueDate.Value.ToString("MMM d, yyyy")</MudText>
                                        }
                                    </div>
                                    <MudSpacer />
                                    @if (task.Importance == "High")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error">!</MudChip>
                                    }
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            }
        }
        else
        {
            <MudAlert Severity="Severity.Info">Select a task list from the menu to view tasks.</MudAlert>
        }
    </MudPaper>
}

@code {
    [Parameter]
    public string? ListId { get; set; }

    private IReadOnlyList<TodoTask> _tasks = [];
    private string? _listDisplayName;
    private bool _loadingTasks;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (ListId is null)
        {
            _tasks = [];
            _listDisplayName = null;
            return;
        }

        _loadingTasks = true;
        _error = null;
        _tasks = [];

        try
        {
            var allLists = await TodoService.GetTaskListsAsync();
            _listDisplayName = allLists.FirstOrDefault(l => l.Id == ListId)?.DisplayName;
            _tasks = await TodoService.GetTasksAsync(ListId);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load tasks: {ex.Message}";
        }
        finally
        {
            _loadingTasks = false;
        }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        _tasks = _tasks.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }
}
