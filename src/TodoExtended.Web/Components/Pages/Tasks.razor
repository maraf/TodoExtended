@page "/tasks/{ListId?}"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject INotificationService Notifications

@{
    var (listEmoji, listName) = PersistedTaskList?.Emoji() ?? (null, "Tasks");
}

<PageTitle>@(PersistedTaskList is not null ? PersistedTaskList.DisplayName : "Tasks")</PageTitle>

<PageHeader Title="@listName" FromColor="from-violet-500" ToColor="to-brand-600" ShadowColor="shadow-brand-500/20">
    <Icon>
        @if (listEmoji is not null)
        {
            <span class="text-xl leading-none">@listEmoji</span>
        }
        else
        {
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
        }
    </Icon>
</PageHeader>

@if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (ListId is null)
{
    <div class="flex flex-col items-center justify-center min-h-[40vh] text-center">
        <div class="text-6xl mb-5">📋</div>
        <h2 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">Pick a list</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Select a task list from the sidebar to get started.</p>
    </div>
}
else
{
    <TaskStatsBar OpenCount="@(TaskItems?.Count(t => !t.IsCompleted) ?? 0)"
                  CompletedCount="@(TaskItems?.Count(t => t.IsCompleted) ?? 0)"
                  @bind-HideCompleted="_hideCompleted" />

    @if (_loadingTasks)
    {
        <TaskListSkeleton />
    }
    else if (TaskItems!.Count == 0)
    {
        <EmptyState Emoji="✅" Heading="Empty list" Description="No tasks in this list yet." />
    }
    else
    {
        <div class="card dark:bg-slate-800 dark:border-slate-700 overflow-hidden">
            @{
                var pct = TaskItems!.Count > 0 ? (int)(100.0 * TaskItems!.Count(t => t.IsCompleted) / TaskItems!.Count) : 0;
                var visibleTasks = _hideCompleted ? TaskItems!.Where(t => !t.IsCompleted).ToList() : TaskItems!.ToList();
            }
            <div class="h-1.5 bg-slate-100 dark:bg-slate-700">
                <div class="h-full bg-gradient-to-r from-violet-500 to-brand-500 rounded-r-full transition-all duration-500" style="width: @(pct)%"></div>
            </div>

            @if (visibleTasks.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-12 text-center">
                    <div class="text-4xl mb-3">✅</div>
                    <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">All tasks completed!</p>
                    <button @onclick="() => _hideCompleted = false" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">Show completed tasks</button>
                </div>
            }
            else
            {
                @foreach (var task in visibleTasks)
                {
                    <div @key="task.Id" class="task-row @(task.IsCompleted ? "opacity-50" : "")">
                        <TaskStatusCheckbox TaskId="@task.Id"
                                            ListId="@ListId"
                                            IsCompleted="@task.IsCompleted"
                                            TaskTitle="@task.Title"
                                            OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                            OnError="(msg) => Notifications.Add(msg, NotifySeverity.Warning)" />
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-200 @(task.IsCompleted ? "line-through text-slate-400 dark:text-slate-500" : "") truncate">
                                @task.Title
                            </p>
                            @if (task.DueDate is not null)
                            {
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    @task.DueDate.Value.ToString("MMM d, yyyy")
                                </p>
                            }
                        </div>
                        @if (task.Importance == "High")
                        {
                            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" title="High priority">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        }
                    </div>
                }
            }
        </div>
    }
}

@code {
    [Parameter]
    public string? ListId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [PersistentState]
    public IReadOnlyList<PersistedTodoTask>? TaskItems { get; set; }

    [PersistentState]
    public string? PersistedListId { get; set; }

    [PersistentState]
    public PersistedTodoTaskList? PersistedTaskList { get; set; }

    private bool _loadingTasks;
    private bool _hideCompleted = true;
    private string? _error;
    private string? _userId;

    private async Task<string> GetUserIdAsync()
    {
        if (_userId is not null) return _userId;
        var state = await AuthState!;
        _userId = state.User.GetUserId();
        return _userId;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ListId is null)
        {
            TaskItems = null;
            PersistedListId = null;
            PersistedTaskList = null;
            return;
        }

        if (TaskItems is not null && PersistedListId == ListId && PersistedTaskList?.Id == ListId)
        {
            _loadingTasks = false;
            return;
        }

        _loadingTasks = true;
        _error = null;
        _hideCompleted = true;
        TaskItems = null;

        try
        {
            var userId = await GetUserIdAsync();
            var allLists = await TodoService.GetTaskListsAsync(userId);
            var matchedList = allLists.FirstOrDefault(l => l.Id == ListId);
            PersistedTaskList = matchedList is not null
                ? new PersistedTodoTaskList(matchedList.Id, matchedList.DisplayName)
                : null;

            TaskItems = (await TodoService.GetTasksAsync(ListId, userId))
                .Select(t => new PersistedTodoTask(t.Id, t.Title, t.IsCompleted, t.DueDate, t.Importance))
                .ToList();
            PersistedListId = ListId;
        }
        catch (Exception ex) when (AuthExceptionHelper.IsIrrecoverableMsalError(ex))
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
            return;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load tasks: {ex.Message}";
        }
        finally
        {
            _loadingTasks = false;
        }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        TaskItems = TaskItems?.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }
}
