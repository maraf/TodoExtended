@page "/tasks/{ListId?}"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject INotificationService Notifications

<PageTitle>Tasks</PageTitle>

@if (_error is not null)
{
    <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-5 py-4 text-sm font-medium">⚠ @_error</div>
}
else if (ListId is null)
{
    <div class="float-card p-16 flex flex-col items-center justify-center text-center">
        <div class="text-6xl mb-5 animate-float">📋</div>
        <h2 class="text-2xl font-extrabold text-slate-700 dark:text-slate-300 mb-2">Pick a list</h2>
        <p class="text-slate-400 dark:text-slate-500 text-sm">Select a task list from the sidebar to get started.</p>
    </div>
}
else
{
    <!-- Page header -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-3xl bg-gradient-to-br from-violet-500 to-brand-600
                        flex items-center justify-center
                        shadow-2xl shadow-brand-500/40
                        flex-shrink-0 animate-float">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Tasks</h1>
            </div>
        </div>
        @if (TaskItems is { Count: > 0 })
        {
            <div class="flex items-center gap-2">
                <span class="chip chip-primary">@TaskItems.Count(t => !t.IsCompleted) open</span>
                @if (TaskItems.Any(t => t.IsCompleted))
                {
                    <span class="chip chip-success">@TaskItems.Count(t => t.IsCompleted) done</span>
                }
            </div>
        }
    </div>

    @if (_loadingTasks)
    {
        <div class="space-y-3">
            @for (int i = 0; i < 5; i++)
            {
                <div class="task-pill opacity-60 animate-pulse">
                    <div class="w-5 h-5 rounded-full bg-slate-200 dark:bg-slate-700 flex-shrink-0"></div>
                    <div class="flex-1 space-y-1.5">
                        <div class="h-4 bg-slate-100 dark:bg-slate-700 rounded-full w-3/4"></div>
                        <div class="h-3 bg-slate-100 dark:bg-slate-700/60 rounded-full w-1/3"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (TaskItems!.Count == 0)
    {
        <div class="float-card p-16 flex flex-col items-center justify-center text-center">
            <div class="text-5xl mb-4 animate-float">✅</div>
            <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">Empty list</h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm">No tasks in this list yet.</p>
        </div>
    }
    else
    {
        <!-- Progress bar — computed inline -->
        <div class="mb-4 flex items-center gap-3">
            <div class="flex-1 h-2 bg-slate-200/60 dark:bg-slate-700/60 rounded-full overflow-hidden backdrop-blur-sm">
                <div class="h-full bg-gradient-to-r from-violet-400 to-brand-500 rounded-full transition-all duration-700 shadow-sm"
                     style="width: @(TaskItems!.Count > 0 ? (int)(100.0 * TaskItems!.Count(t => t.IsCompleted) / TaskItems!.Count) : 0)%"></div>
            </div>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 tabular-nums flex-shrink-0">@(TaskItems!.Count > 0 ? (int)(100.0 * TaskItems!.Count(t => t.IsCompleted) / TaskItems!.Count) : 0)%</span>
        </div>

        <!-- Individual floating task pills -->
        <div class="space-y-2.5">
            @foreach (var task in TaskItems!)
            {
                <div class="task-pill @(task.IsCompleted ? "opacity-60" : "")">
                    <TaskStatusCheckbox TaskId="@task.Id"
                                        ListId="@ListId"
                                        IsCompleted="@task.IsCompleted"
                                        TaskTitle="@task.Title"
                                        OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                        OnError="(msg) => Notifications.Add(msg, NotifySeverity.Warning)" />
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-slate-800 dark:text-slate-200
                                  @(task.IsCompleted ? "line-through text-slate-400 dark:text-slate-500" : "") truncate">
                            @task.Title
                        </p>
                        @if (task.DueDate is not null)
                        {
                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                @task.DueDate.Value.ToString("MMM d, yyyy")
                            </p>
                        }
                    </div>
                    @if (task.Importance == "High")
                    {
                        <span class="chip chip-error flex-shrink-0" title="High priority">!</span>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public string? ListId { get; set; }

    [PersistentState]
    public IReadOnlyList<TodoTask>? TaskItems { get; set; }

    [PersistentState]
    public string? PersistedListId { get; set; }

    private bool _loadingTasks;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (ListId is null) { TaskItems = null; PersistedListId = null; return; }
        if (TaskItems is not null && PersistedListId == ListId) { _loadingTasks = false; return; }

        _loadingTasks = true; _error = null; TaskItems = null;
        try
        {
            TaskItems = await TodoService.GetTasksAsync(ListId);
            PersistedListId = ListId;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex) { _error = $"Failed to load tasks: {ex.Message}"; }
        finally { _loadingTasks = false; }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
        => TaskItems = TaskItems?.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
}
