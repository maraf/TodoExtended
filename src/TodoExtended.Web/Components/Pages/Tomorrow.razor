@page "/tomorrow"
@attribute [Authorize]
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<Tomorrow> Logger
@inject INotificationService Notifications
@inject IUserTimeZoneService UserTimeZoneService

<PageTitle>Tomorrow</PageTitle>

<PageHeader Title="Tomorrow" FromColor="from-sky-400" ToColor="to-blue-500" ShadowColor="shadow-sky-500/20">
    <Icon>
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
    </Icon>
</PageHeader>

<p class="text-slate-500 dark:text-slate-400 text-sm mb-6">@(_tomorrowDate?.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture) ?? DateTime.Today.AddDays(1).ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture))</p>

<TaskStatsBar OpenCount="@(TomorrowTasks?.Count(t => !t.IsCompleted) ?? 0)"
              CompletedCount="@(TomorrowTasks?.Count(t => t.IsCompleted) ?? 0)"
              OpenLabel="remaining"
              @bind-HideCompleted="_hideCompleted"
              @bind-RescheduleMode="_rescheduleMode" />

@if (_loading)
{
    <TaskListSkeleton RowCount="4"
                      GradientClasses="from-sky-400 via-blue-500 to-indigo-500"
                      ShowBadgeSkeleton="true" />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (TomorrowTasks is not { Count: > 0 })
{
    <EmptyState Heading="Nothing scheduled! 📅" Description="No tasks due tomorrow. Plan ahead or relax.">
        <CustomIcon>
            <div class="w-16 h-16 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center mb-5">
                <svg class="w-8 h-8 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </div>
        </CustomIcon>
    </EmptyState>
}
else
{
    <div class="card dark:bg-slate-800 dark:border-slate-700 overflow-hidden">
        <!-- Progress bar -->
        @{
            var pct = TomorrowTasks.Count > 0 ? (int)(100.0 * TomorrowTasks.Count(t => t.IsCompleted) / TomorrowTasks.Count) : 0;
            var visibleTasks = _hideCompleted ? TomorrowTasks.Where(t => !t.IsCompleted).ToList() : TomorrowTasks.ToList();
        }
        <div class="h-1.5 bg-slate-100 dark:bg-slate-700">
            <div class="h-full bg-gradient-to-r from-sky-400 to-blue-500 rounded-r-full transition-all duration-500" style="width: @(pct)%"></div>
        </div>

        @if (visibleTasks.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-12 text-center">
                <div class="text-4xl mb-3">✅</div>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">All tasks completed!</p>
                <button @onclick="() => _hideCompleted = false" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">Show completed tasks</button>
            </div>
        }
        else
        {
            @foreach (var task in visibleTasks)
            {
                var capturedTask = task;
                <div @key="task.Id" class="task-row @(task.IsCompleted ? "opacity-50" : "") flex-wrap">
                    <TaskStatusCheckbox TaskId="@task.Id"
                                        ListId="@task.ListId"
                                        IsCompleted="@task.IsCompleted"
                                        TaskTitle="@task.Title"
                                        OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                        OnError="(msg) => Notifications.Add(msg, NotifySeverity.Warning)" />
                    <span class="flex-1 min-w-0 text-sm font-medium text-slate-800 dark:text-slate-200 @(task.IsCompleted ? "line-through text-slate-400 dark:text-slate-500" : "") truncate">
                        @task.Title
                    </span>
                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        <span class="chip chip-info text-xs hidden sm:inline-flex">@task.ListName</span>
                        @if (task.Importance == "High")
                        {
                            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" title="High priority">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        }
                    </div>
                    <RescheduleDatePicker Visible="@(_rescheduleMode && !task.IsCompleted)"
                                         IsMoving="@(_movingTaskId == task.Id)"
                                         IsDisabled="@(_movingTaskId is not null)"
                                         DateOptions="@_dateOptions"
                                         OnDateSelected="date => MoveTaskAsync(capturedTask, date)" />
                </div>
            }
        }
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [PersistentState]
    public IReadOnlyList<PersistedTodoTaskWithList>? TomorrowTasks { get; set; }

    private bool _loading = true;
    private bool _hideCompleted = false;
    private bool _rescheduleMode = false;
    private string? _error;
    private string? _movingTaskId;
    private List<(string Label, DateOnly Date)> _dateOptions = [];
    private DateOnly? _tomorrowDate;

    protected override async Task OnInitializedAsync()
    {
        if (TomorrowTasks is not null)
        {
            Logger.LogDebug("OnInitializedAsync: TomorrowTasks restored from persistent state, count={Count}", TomorrowTasks.Count);
            _loading = false;
            await BuildDateOptionsAsync();
            return;
        }

        try
        {
            var authState = await AuthState!;
            var userId = authState.User.GetUserId();

            Logger.LogDebug("OnInitializedAsync: TomorrowTasks not in persistent state, fetching fresh");
            TomorrowTasks = (await TodoService.GetTomorrowTasksAsync(userId))
                .Select(t => new PersistedTodoTaskWithList(t.Id, t.Title, t.IsCompleted, t.Importance, t.ListId, t.ListName))
                .ToList();
            Logger.LogDebug("OnInitializedAsync: Fetched {Count} tasks", TomorrowTasks?.Count ?? 0);
        }
        catch (Exception ex) when (!AuthExceptionHelper.IsAuthException(ex))
        {
            _error = $"Failed to load tomorrow's tasks: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        await BuildDateOptionsAsync();
    }

    private async Task BuildDateOptionsAsync()
    {
        var today = await UserTimeZoneService.GetTodayAsync();
        _tomorrowDate = today.AddDays(1);
        _dateOptions = DateRescheduleOptions.Build(today, includeToday: true);
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        Logger.LogDebug("HandleTaskStatusChanged: TaskId={TaskId}, NewStatus={NewStatus}", taskId, newStatus);
        TomorrowTasks = TomorrowTasks!.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }

    private async Task MoveTaskAsync(PersistedTodoTaskWithList task, DateOnly targetDate)
    {
        if (_movingTaskId is not null) return;
        _movingTaskId = task.Id;
        try
        {
            var authState = await AuthState!;
            var userId = authState.User.GetUserId();
            await TodoService.SetTaskDueDateAsync(task.ListId, task.Id, targetDate, userId);
            TomorrowTasks = TomorrowTasks!.Where(t => t.Id != task.Id).ToList();
            Notifications.Add($"'{task.Title}' moved to {targetDate:MMM d}", NotifySeverity.Success);
        }
        catch (Exception ex) when (!AuthExceptionHelper.IsAuthException(ex))
        {
            Logger.LogError(ex, "MoveTaskAsync: Failed to move task {TaskId}", task.Id);
            Notifications.Add($"Failed to reschedule task: {ex.Message}", NotifySeverity.Warning);
        }
        finally
        {
            _movingTaskId = null;
        }
    }
}
