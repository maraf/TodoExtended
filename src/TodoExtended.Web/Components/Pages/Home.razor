@page "/"
@using Microsoft.Identity.Web
@using Microsoft.Extensions.Options
@using TodoExtended.Web.Data
@using TodoExtended.Web.Services
@inject ITemplateService TemplateService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IOptions<DemoOptions> DemoOptions

<PageTitle>TodoExtended</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" Class="mb-2">TodoExtended</MudText>

        @if (_loading)
        {
            <MudGrid>
                @for (int i = 0; i < 3; i++)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                    </MudItem>
                }
            </MudGrid>
        }
        else if (_templateError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_templateError</MudAlert>
        }
        else if (_templates is { Count: > 0 })
        {
            <MudText Typo="Typo.h6" Class="mt-6 mb-3">Quick Create</MudText>
            <MudGrid>
                @foreach (var template in _templates)
                {
                    var t = template;
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">@t.Title</MudText>
                                @if (!string.IsNullOrEmpty(t.TaskListName))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@t.TaskListName</MudText>
                                }
                            </MudCardContent>
                            <MudCardActions>
                                @if (_executingTemplateId == t.Id)
                                {
                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="() => ExecuteTemplate(t)">
                                        Create
                                    </MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudText Typo="Typo.body2" Class="mt-4">
            <MudLink Href="templates">Manage templates →</MudLink>
        </MudText>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center" Style="min-height: 100vh;">
            <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center" Style="text-align: center; max-width: 800px;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Primary" Style="font-size: 80px;" Class="mb-4" />
                
                <MudText Typo="Typo.h2" Class="mb-2" Style="font-weight: 500;">TodoExtended</MudText>
                <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-6">
                    Supercharge your productivity with Microsoft To Do
                </MudText>

                <MudButton Href="MicrosoftIdentity/Account/SignIn" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Login"
                           Class="mb-8"
                           Style="padding: 12px 32px; font-size: 1.1rem;">
                    Sign in with Microsoft
                </MudButton>

                @if (DemoOptions.Value.Enabled)
                {
                    <MudButton Href="/auth/demo-signin"
                               Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.PlayCircle"
                               Class="mb-8 ml-4"
                               Style="padding: 12px 32px; font-size: 1.1rem;">
                        Try Demo
                    </MudButton>
                }

                <MudDivider Class="my-8" Style="width: 100%;" />

                <MudText Typo="Typo.h5" Class="mb-6" Style="font-weight: 500;">Key Features</MudText>

                <MudGrid Spacing="4" Justify="Justify.Center">
                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                            <MudCardContent Class="d-flex flex-column align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Today" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="mb-2">Today View</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                    Focus on what matters today. See all tasks due today across all your lists in one place.
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                            <MudCardContent Class="d-flex flex-column align-center">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="mb-2">Task Templates</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                    Create recurring tasks instantly. Set up templates and create tasks with one click.
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                            <MudCardContent Class="d-flex flex-column align-center">
                                <MudIcon Icon="@Icons.Material.Filled.FlashOn" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="mb-2">Quick Create</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                    Lightning-fast task creation from your templates right from the home screen.
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                            <MudCardContent Class="d-flex flex-column align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Watch" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="mb-2">Garmin Watch Companion</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                    Check your tasks and complete them right from your Garmin smartwatch.
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-8">
                    Powered by Microsoft To Do. Sign in with your Microsoft account to get started.
                </MudText>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<TaskTemplate>? _templates;
    private bool _loading = true;
    private string? _templateError;
    private Guid? _executingTemplateId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                try
                {
                    var all = await TemplateService.GetAllAsync();
                    _templates = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
                }
                catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
                {
                    NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
                    return;
                }
                catch (Exception ex)
                {
                    _templateError = $"Failed to load templates: {ex.Message}";
                }
            }
        }

        _loading = false;
    }

    private async Task ExecuteTemplate(TaskTemplate template)
    {
        _executingTemplateId = template.Id;

        try
        {
            await TemplateService.ExecuteTemplateAsync(template.Id);
            Snackbar.Add($"Created task \"{template.Title}\" successfully!", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create task: {ex.Message}", Severity.Error);
        }
        finally
        {
            _executingTemplateId = null;
        }
    }
}
