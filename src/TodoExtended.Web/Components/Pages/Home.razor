@page "/"
@using Microsoft.Identity.Web
@using TodoExtended.Web.Data
@inject ITemplateService TemplateService
@inject NavigationManager NavigationManager

<PageTitle>TodoExtended</PageTitle>

<h1>TodoExtended</h1>

<p>An alternative view for Microsoft To Do with extended features.</p>

<AuthorizeView>
    <Authorized>
        <p>Welcome, <strong>@context.User.Identity?.Name</strong>! Head to <a href="tasks">My Tasks</a> to see your to-do lists.</p>

        @if (_loading)
        {
            <p><em>Loading templates...</em></p>
        }
        else if (_templateError is not null)
        {
            <div class="alert alert-danger">@_templateError</div>
        }
        else if (_templates is { Count: > 0 })
        {
            <h5 class="mt-4">Quick Create</h5>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var template in _templates)
                {
                    var t = template;
                    <button class="btn btn-primary"
                            disabled="@(_executingTemplateId == t.Id)"
                            @onclick="() => ExecuteTemplate(t)">
                        @if (_executingTemplateId == t.Id)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        @t.Title
                    </button>
                }
            </div>
        }

        @if (_feedbackMessage is not null)
        {
            <div class="alert @(_feedbackIsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
                @_feedbackMessage
                <button type="button" class="btn-close" @onclick="() => _feedbackMessage = null"></button>
            </div>
        }

        <p><a href="templates">Manage templates &rarr;</a></p>
    </Authorized>
    <NotAuthorized>
        <p><a href="MicrosoftIdentity/Account/SignIn">Sign in with your Microsoft account</a> to get started.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<TaskTemplate>? _templates;
    private bool _loading = true;
    private string? _templateError;
    private int? _executingTemplateId;
    private string? _feedbackMessage;
    private bool _feedbackIsError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                try
                {
                    var all = await TemplateService.GetAllAsync();
                    _templates = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
                }
                catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
                {
                    NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
                    return;
                }
                catch (Exception ex)
                {
                    _templateError = $"Failed to load templates: {ex.Message}";
                }
            }
        }

        _loading = false;
    }

    private async Task ExecuteTemplate(TaskTemplate template)
    {
        _executingTemplateId = template.Id;
        _feedbackMessage = null;

        try
        {
            await TemplateService.ExecuteTemplateAsync(template.Id);
            _feedbackMessage = $"Created task \"{template.Title}\" successfully!";
            _feedbackIsError = false;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Failed to create task: {ex.Message}";
            _feedbackIsError = true;
        }
        finally
        {
            _executingTemplateId = null;
        }
    }
}
