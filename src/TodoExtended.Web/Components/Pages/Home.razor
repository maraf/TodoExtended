@page "/"
@using Microsoft.Identity.Web
@using TodoExtended.Web.Data
@inject ITemplateService TemplateService
@inject NavigationManager NavigationManager

<PageTitle>TodoExtended</PageTitle>

<Heading Tag="HeadingTag.H1" class="mb-4">TodoExtended</Heading>

<Paragraph class="mb-6 text-gray-500 dark:text-gray-400">An alternative view for Microsoft To Do with extended features.</Paragraph>

<AuthorizeView>
    <Authorized>
        <Paragraph class="mb-4">Welcome, <span class="font-semibold">@context.User.Identity?.Name</span>! Head to <a href="tasks" class="text-blue-600 hover:underline dark:text-blue-400">My Tasks</a> to see your to-do lists.</Paragraph>

        @if (_loading)
        {
            <div class="flex items-center gap-2 mb-4">
                <Spinner Size="SpinnerSize.Sm" Color="SpinnerColor.Info" />
                <span class="text-gray-500 dark:text-gray-400">Loading templates...</span>
            </div>
        }
        else if (_templateError is not null)
        {
            <Alert Color="AlertColor.Failure" class="mb-4">
                <CustomContent>@_templateError</CustomContent>
            </Alert>
        }
        else if (_templates is { Count: > 0 })
        {
            <Heading Tag="HeadingTag.H5" class="mt-6 mb-3">Quick Create</Heading>
            <div class="flex flex-wrap gap-2 mb-4">
                @foreach (var template in _templates)
                {
                    var t = template;
                    <Button Color="ButtonColor.Primary"
                            Disabled="@(_executingTemplateId == t.Id)"
                            Loading="@(_executingTemplateId == t.Id)"
                            OnClick="() => ExecuteTemplate(t)">
                        @t.Title
                    </Button>
                }
            </div>
        }

        @if (_feedbackMessage is not null)
        {
            <Alert Color="@(_feedbackIsError ? AlertColor.Failure : AlertColor.Success)" class="mb-4">
                <CustomContent>
                    <div class="flex items-center justify-between">
                        <span>@_feedbackMessage</span>
                        <button class="ml-4 text-sm font-medium hover:opacity-75" @onclick="() => _feedbackMessage = null">✕</button>
                    </div>
                </CustomContent>
            </Alert>
        }

        <Paragraph><a href="templates" class="text-blue-600 hover:underline dark:text-blue-400">Manage templates →</a></Paragraph>
    </Authorized>
    <NotAuthorized>
        <Paragraph><a href="MicrosoftIdentity/Account/SignIn" class="text-blue-600 hover:underline dark:text-blue-400">Sign in with your Microsoft account</a> to get started.</Paragraph>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<TaskTemplate>? _templates;
    private bool _loading = true;
    private string? _templateError;
    private int? _executingTemplateId;
    private string? _feedbackMessage;
    private bool _feedbackIsError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                try
                {
                    var all = await TemplateService.GetAllAsync();
                    _templates = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
                }
                catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
                {
                    NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
                    return;
                }
                catch (Exception ex)
                {
                    _templateError = $"Failed to load templates: {ex.Message}";
                }
            }
        }

        _loading = false;
    }

    private async Task ExecuteTemplate(TaskTemplate template)
    {
        _executingTemplateId = template.Id;
        _feedbackMessage = null;

        try
        {
            await TemplateService.ExecuteTemplateAsync(template.Id);
            _feedbackMessage = $"Created task \"{template.Title}\" successfully!";
            _feedbackIsError = false;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Failed to create task: {ex.Message}";
            _feedbackIsError = true;
        }
        finally
        {
            _executingTemplateId = null;
        }
    }
}
