@page "/"
@using Microsoft.Identity.Web
@using Microsoft.Extensions.Options
@using TodoExtended.Web.Data
@using TodoExtended.Web.Services
@inject ITemplateService TemplateService
@inject NavigationManager NavigationManager
@inject INotificationService Notifications
@inject IOptions<DemoOptions> DemoOptions

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <!-- Dashboard header -->
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Dashboard</h1>
            <p class="mt-1 text-slate-500 dark:text-slate-400">Welcome back! Quick-create your tasks below.</p>
        </div>

        @if (_loading)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="h-36 rounded-3xl animate-pulse"
                         style="background: linear-gradient(135deg, rgba(99,102,241,0.07) 0%, rgba(139,92,246,0.05) 100%); border: 1px solid rgba(255,255,255,0.8)">
                    </div>
                }
            </div>
        }
        else if (_templateError is not null)
        {
            <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-5 py-4 text-sm font-medium">⚠ @_templateError</div>
        }
        else if (_templates is { Count: > 0 })
        {
            <!-- Section header -->
            <div class="flex items-center gap-3 mb-5">
                <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-brand-500 to-violet-600 flex items-center justify-center shadow-lg shadow-brand-500/30">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-800 dark:text-white leading-none">Quick Create</h2>
                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Click a template to instantly create a task</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var template in _templates)
                {
                    var t = template;
                    <!-- Float card with ambient glow -->
                    <div class="float-card p-5 flex flex-col gap-4 group relative overflow-hidden">
                        <!-- Subtle gradient top bar -->
                        <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-brand-400/0 via-brand-500/60 to-violet-500/0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-brand-100 to-violet-100 dark:from-brand-900/50 dark:to-violet-900/40 flex items-center justify-center flex-shrink-0 shadow-sm group-hover:shadow-md group-hover:scale-110 transition-all duration-200">
                                <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="font-bold text-slate-900 dark:text-white text-sm leading-tight">@t.Title</p>
                                @if (!string.IsNullOrEmpty(t.TaskListName))
                                {
                                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5 flex items-center gap-1">
                                        <span class="w-1 h-1 rounded-full bg-brand-400 dark:bg-brand-500 inline-block"></span>
                                        @t.TaskListName
                                    </p>
                                }
                            </div>
                        </div>

                        @if (_executingTemplateId == t.Id)
                        {
                            <div class="h-1.5 w-full bg-brand-100 dark:bg-brand-900/30 rounded-full overflow-hidden">
                                <div class="h-full w-2/3 bg-gradient-to-r from-brand-500 to-violet-500 rounded-full animate-pulse"></div>
                            </div>
                        }
                        else
                        {
                            <button @onclick="() => ExecuteTemplate(t)"
                                    class="btn bg-gradient-to-r from-brand-600 to-violet-600 hover:from-brand-500 hover:to-violet-500 text-white text-xs px-4 py-2.5 rounded-xl w-full shadow-md shadow-brand-500/20 hover:shadow-lg hover:shadow-brand-500/30 active:scale-[.97]">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                                </svg>
                                Create Task
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty state — floating glass card -->
            <div class="float-card p-12 flex flex-col items-center justify-center text-center">
                <div class="w-16 h-16 rounded-3xl bg-gradient-to-br from-brand-100 to-violet-100 dark:from-brand-900/40 dark:to-violet-900/30 flex items-center justify-center mb-5 shadow-inner text-3xl animate-float">
                    📋
                </div>
                <h3 class="text-lg font-bold text-slate-700 dark:text-slate-300 mb-2">No templates yet</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6 max-w-xs">
                    Set up templates to create tasks instantly from here.
                </p>
                <a href="/templates" class="btn bg-gradient-to-r from-brand-600 to-violet-600 text-white text-sm px-6 py-2.5 rounded-2xl shadow-lg shadow-brand-500/25 hover:shadow-xl hover:shadow-brand-500/30 hover:-translate-y-0.5 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Create Template
                </a>
            </div>
        }

        <div class="mt-8 pt-6 border-t border-slate-100/80 dark:border-slate-700/40">
            <a href="/templates" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Manage templates →
            </a>
        </div>
    </Authorized>

    <NotAuthorized>
        <!-- ░░ DRAMATIC LANDING PAGE ░░ -->
        <div class="min-h-screen relative overflow-hidden bg-slate-950">

            <!-- ── Large animated gradient orbs ── -->
            <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
                <!-- Primary orb — top right -->
                <div class="absolute -top-32 -right-32 w-[700px] h-[700px]
                             bg-gradient-to-br from-brand-600 via-violet-600 to-fuchsia-600
                             rounded-full blur-3xl opacity-20 animate-float"></div>
                <!-- Secondary orb — bottom left -->
                <div class="absolute -bottom-48 -left-48 w-[600px] h-[600px]
                             bg-gradient-to-tr from-violet-700 via-fuchsia-600 to-pink-600
                             rounded-full blur-3xl opacity-15 animate-float-slow"></div>
                <!-- Accent orb — centre -->
                <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px]
                             bg-gradient-to-br from-sky-500 to-brand-600
                             rounded-full blur-3xl opacity-10 animate-float-delay"></div>
                <!-- Small sparkle — top left -->
                <div class="absolute top-24 left-24 w-64 h-64
                             bg-gradient-to-br from-emerald-400 to-cyan-500
                             rounded-full blur-3xl opacity-10 animate-float-delay2"></div>
            </div>

            <!-- ── Noise / dot-grid overlay ── -->
            <div class="absolute inset-0 opacity-[0.12]"
                 style="background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1px, transparent 1px); background-size: 28px 28px;"
                 aria-hidden="true"></div>

            <div class="relative z-10 flex flex-col min-h-screen">

                <!-- Topbar -->
                <header class="flex items-center justify-between px-6 py-5 max-w-7xl mx-auto w-full">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-brand-500 to-violet-500 flex items-center justify-center text-white font-black text-sm shadow-xl shadow-brand-500/40">✓</div>
                        <span class="text-white font-extrabold text-lg tracking-tight">TodoExtended</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="MicrosoftIdentity/Account/SignIn"
                           class="text-white/60 hover:text-white text-sm font-medium transition-colors">
                            Sign in
                        </a>
                        @if (DemoOptions.Value.Enabled)
                        {
                            <a href="/auth/demo-signin"
                               class="btn bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs px-4 py-2 rounded-xl backdrop-blur-sm font-semibold"
                               data-enhance-nav="false">
                                Try Demo →
                            </a>
                        }
                    </div>
                </header>

                <!-- ── Hero ── -->
                <main class="flex-1 flex flex-col items-center justify-center text-center px-4 py-12 sm:py-20">

                    <!-- Status badge -->
                    <div class="inline-flex items-center gap-2 bg-white/8 backdrop-blur-md text-white/75 text-xs font-semibold rounded-full px-4 py-2 mb-10 border border-white/12 shadow-lg animate-slide-up">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        Powered by Microsoft To Do
                    </div>

                    <!-- Title — large stacked with gradient accent -->
                    <h1 class="text-[clamp(3.5rem,10vw,7rem)] font-black text-white tracking-[-0.05em] leading-[0.9] mb-8 max-w-4xl"
                        style="animation: slideUp 0.5s cubic-bezier(0.16,1,0.3,1) 0.05s both;">
                        Todo
                        <span class="bg-gradient-to-r from-brand-400 via-violet-400 to-fuchsia-400 bg-clip-text text-transparent"
                              style="display: inline-block; animation: float 5s ease-in-out infinite;">
                            Extended
                        </span>
                    </h1>

                    <p class="text-lg sm:text-xl text-white/55 max-w-lg mb-12 leading-relaxed"
                       style="animation: slideUp 0.5s cubic-bezier(0.16,1,0.3,1) 0.12s both;">
                        Supercharge your productivity — templates, Garmin watch support, and powerful task management in one place.
                    </p>

                    <!-- CTA buttons -->
                    <div class="flex flex-wrap items-center justify-center gap-4 mb-24"
                         style="animation: slideUp 0.5s cubic-bezier(0.16,1,0.3,1) 0.2s both;">
                        <a href="MicrosoftIdentity/Account/SignIn"
                           class="btn bg-gradient-to-r from-brand-500 to-violet-600 hover:from-brand-400 hover:to-violet-500 text-white text-sm px-9 py-4 rounded-2xl font-bold shadow-2xl shadow-brand-600/40 hover:shadow-brand-500/50 hover:-translate-y-1 transition-all duration-200">
                            Sign in with Microsoft
                        </a>
                        @if (DemoOptions.Value.Enabled)
                        {
                            <a href="/auth/demo-signin"
                               class="btn bg-white/8 hover:bg-white/15 text-white border border-white/20 backdrop-blur-sm text-sm px-9 py-4 rounded-2xl font-bold hover:-translate-y-1 transition-all duration-200"
                               data-enhance-nav="false">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Live Demo
                            </a>
                        }
                    </div>

                    <!-- Floating feature cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl w-full text-left"
                         style="animation: slideUp 0.5s cubic-bezier(0.16,1,0.3,1) 0.28s both;">

                        <div class="group bg-white/5 hover:bg-white/10 backdrop-blur-md border border-white/10 hover:border-white/20 rounded-3xl p-6
                                    shadow-xl shadow-black/20 hover:shadow-2xl hover:shadow-brand-500/10
                                    hover:-translate-y-2 transition-all duration-300">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500/30 to-brand-600/20 border border-brand-500/20 flex items-center justify-center mb-5 text-2xl group-hover:scale-110 group-hover:animate-float transition-transform duration-300">☀️</div>
                            <h3 class="text-white font-bold mb-2 text-sm tracking-tight">Today View</h3>
                            <p class="text-white/45 text-xs leading-relaxed">All tasks due today across every list in one focused view.</p>
                        </div>

                        <div class="group bg-white/5 hover:bg-white/10 backdrop-blur-md border border-white/10 hover:border-white/20 rounded-3xl p-6
                                    shadow-xl shadow-black/20 hover:shadow-2xl hover:shadow-violet-500/10
                                    hover:-translate-y-2 transition-all duration-300" style="transition-delay: 50ms;">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-500/30 to-violet-600/20 border border-violet-500/20 flex items-center justify-center mb-5 text-2xl group-hover:scale-110 group-hover:animate-float transition-transform duration-300">⚡</div>
                            <h3 class="text-white font-bold mb-2 text-sm tracking-tight">Task Templates</h3>
                            <p class="text-white/45 text-xs leading-relaxed">Create recurring tasks instantly with one click from templates.</p>
                        </div>

                        <div class="group bg-white/5 hover:bg-white/10 backdrop-blur-md border border-white/10 hover:border-white/20 rounded-3xl p-6
                                    shadow-xl shadow-black/20 hover:shadow-2xl hover:shadow-emerald-500/10
                                    hover:-translate-y-2 transition-all duration-300" style="transition-delay: 100ms;">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500/30 to-emerald-600/20 border border-emerald-500/20 flex items-center justify-center mb-5 text-2xl group-hover:scale-110 group-hover:animate-float transition-transform duration-300">🚀</div>
                            <h3 class="text-white font-bold mb-2 text-sm tracking-tight">Quick Create</h3>
                            <p class="text-white/45 text-xs leading-relaxed">Lightning-fast task creation right from your dashboard.</p>
                        </div>

                        <div class="group bg-white/5 hover:bg-white/10 backdrop-blur-md border border-white/10 hover:border-white/20 rounded-3xl p-6
                                    shadow-xl shadow-black/20 hover:shadow-2xl hover:shadow-amber-500/10
                                    hover:-translate-y-2 transition-all duration-300" style="transition-delay: 150ms;">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-500/30 to-amber-600/20 border border-amber-500/20 flex items-center justify-center mb-5 text-2xl group-hover:scale-110 group-hover:animate-float transition-transform duration-300">⌚</div>
                            <h3 class="text-white font-bold mb-2 text-sm tracking-tight">Garmin Watch</h3>
                            <p class="text-white/45 text-xs leading-relaxed">Check and complete tasks directly from your Garmin smartwatch.</p>
                        </div>
                    </div>
                </main>

                <footer class="text-center pb-8 text-white/25 text-xs tracking-wide">
                    Powered by Microsoft To Do · TodoExtended
                </footer>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<TaskTemplate>? _templates;
    private bool _loading = true;
    private string? _templateError;
    private Guid? _executingTemplateId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                try
                {
                    var all = await TemplateService.GetAllAsync();
                    _templates = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
                }
                catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
                {
                    NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
                    return;
                }
                catch (Exception ex)
                {
                    _templateError = $"Failed to load templates: {ex.Message}";
                }
            }
        }
        _loading = false;
    }

    private async Task ExecuteTemplate(TaskTemplate template)
    {
        _executingTemplateId = template.Id;
        try
        {
            await TemplateService.ExecuteTemplateAsync(template.Id);
            Notifications.Add($"Created \"{template.Title}\" ✓", NotifySeverity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Notifications.Add($"Failed: {ex.Message}", NotifySeverity.Error);
        }
        finally { _executingTemplateId = null; }
    }
}
