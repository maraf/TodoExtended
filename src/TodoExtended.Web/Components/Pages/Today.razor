@page "/today"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<Today> Logger

<PageTitle>Today</PageTitle>

<Heading Tag="HeadingTag.H1" class="mb-6">Today</Heading>

@if (_loading)
{
    <div class="flex items-center gap-2">
        <Spinner Size="SpinnerSize.Sm" Color="SpinnerColor.Info" />
        <span class="text-gray-500 dark:text-gray-400">Loading today's tasks...</span>
    </div>
}
else if (_error is not null)
{
    <Alert Color="AlertColor.Failure">
        <CustomContent>@_error</CustomContent>
    </Alert>
}
else if (TodayTasks is not { Count: > 0 })
{
    <Paragraph class="text-gray-500 dark:text-gray-400">No tasks due today! 🎉</Paragraph>
}
else
{
    @if (_toggleError is not null)
    {
        <Alert Color="AlertColor.Warning" class="mb-4">
            <CustomContent>
                <div class="flex items-center justify-between">
                    <span>@_toggleError</span>
                    <button class="ml-4 text-sm font-medium hover:opacity-75" @onclick="() => _toggleError = null">✕</button>
                </div>
            </CustomContent>
        </Alert>
    }

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm dark:bg-gray-800 dark:border-gray-700 divide-y divide-gray-200 dark:divide-gray-700">
        @foreach (var task in TodayTasks)
        {
            <div class="flex items-center px-4 py-3">
                <TaskStatusCheckbox TaskId="@task.Id"
                                    ListId="@task.ListId"
                                    IsCompleted="@task.IsCompleted"
                                    TaskTitle="@task.Title"
                                    OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                    OnError="(msg) => _toggleError = msg" />
                <div class="flex-1">
                    <span class="@(task.IsCompleted ? "line-through text-gray-400 dark:text-gray-500" : "text-gray-900 dark:text-white")">
                        @task.Title
                    </span>
                    <span class="text-sm text-gray-500 dark:text-gray-400 ml-2">@task.ListName</span>
                    @if (task.Importance == "High")
                    {
                        <Badge Color="BadgeColor.Pink" class="ml-2">!</Badge>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [PersistentState]
    public IReadOnlyList<TodoTaskWithList>? TodayTasks { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _toggleError;

    protected override async Task OnInitializedAsync()
    {
        if (TodayTasks is not null)
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks restored from persistent state, count={Count}", TodayTasks.Count);
            _loading = false;
            return;
        }

        try
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks not in persistent state, fetching fresh");
            TodayTasks = await TodoService.GetTodayTasksAsync();
            Logger.LogDebug("OnInitializedAsync: Fetched {Count} tasks", TodayTasks?.Count ?? 0);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load today's tasks: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        _toggleError = null;
        Logger.LogDebug("HandleTaskStatusChanged: TaskId={TaskId}, NewStatus={NewStatus}", taskId, newStatus);
        TodayTasks = TodayTasks!.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }
}
