@page "/today"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<Today> Logger

<PageTitle>Today</PageTitle>

<h1>Today</h1>

@if (_loading)
{
    <p><em>Loading today's tasks...</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (TodayTasks is not { Count: > 0 })
{
    <p class="text-muted">No tasks due today! 🎉</p>
}
else
{
    @if (_toggleError is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @_toggleError
            <button type="button" class="btn-close" @onclick="() => _toggleError = null"></button>
        </div>
    }

    <ul class="list-group">
        @foreach (var task in TodayTasks)
        {
            var isToggling = _togglingTaskId == task.Id;
            <li class="list-group-item d-flex align-items-center">
                @if (isToggling)
                {
                    <span class="spinner-border spinner-border-sm me-3" role="status"></span>
                }
                else
                {
                    <input type="checkbox" checked="@task.IsCompleted"
                           class="form-check-input me-3"
                           @onchange="() => ToggleTaskStatus(task)" />
                }
                <div class="flex-grow-1">
                    <span class="@(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                        @task.Title
                    </span>
                    <small class="text-muted ms-2">@task.ListName</small>
                    @if (task.Importance == "High")
                    {
                        <span class="badge bg-danger ms-2">!</span>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    [PersistentState]
    public IReadOnlyList<TodoTaskWithList>? TodayTasks { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _togglingTaskId;
    private string? _toggleError;

    protected override async Task OnInitializedAsync()
    {
        if (TodayTasks is not null)
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks restored from persistent state, count={Count}", TodayTasks.Count);
            _loading = false;
            return;
        }

        try
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks not in persistent state, fetching fresh");
            TodayTasks = await TodoService.GetTodayTasksAsync();
            Logger.LogDebug("OnInitializedAsync: Fetched {Count} tasks", TodayTasks?.Count ?? 0);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load today's tasks: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleTaskStatus(TodoTaskWithList task)
    {
        if (_togglingTaskId is not null)
        {
            Logger.LogDebug("ToggleTaskStatus: Already toggling {TogglingTaskId}, ignoring click for {TaskId}", _togglingTaskId, task.Id);
            return;
        }

        _togglingTaskId = task.Id;
        _toggleError = null;
        var newStatus = !task.IsCompleted;

        Logger.LogDebug("ToggleTaskStatus: TaskId={TaskId}, Title='{Title}', ListId={ListId}, CurrentStatus={Current}, NewStatus={New}",
            task.Id, task.Title, task.ListId, task.IsCompleted, newStatus);

        // Optimistically update the visual state
        var original = TodayTasks!;
        TodayTasks = original.Select(t => t.Id == task.Id
            ? t with { IsCompleted = newStatus }
            : t).ToList();

        try
        {
            Logger.LogDebug("ToggleTaskStatus: Calling UpdateTaskStatusAsync for TaskId={TaskId}", task.Id);
            await TodoService.UpdateTaskStatusAsync(task.ListId, task.Id, newStatus);
            Logger.LogDebug("ToggleTaskStatus: Successfully updated TaskId={TaskId} to completed={NewStatus}", task.Id, newStatus);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            Logger.LogWarning("ToggleTaskStatus: Auth challenge for TaskId={TaskId}, redirecting to sign-in", task.Id);
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ToggleTaskStatus: Failed to update TaskId={TaskId}, Title='{Title}', reverting optimistic update", task.Id, task.Title);
            TodayTasks = original;
            _toggleError = $"Failed to update \"{task.Title}\". Please try again.";
        }
        finally
        {
            _togglingTaskId = null;
        }
    }
}
