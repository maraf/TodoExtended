@page "/today"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<Today> Logger
@inject INotificationService Notifications

<PageTitle>Today</PageTitle>

<SectionContent SectionName="page-header">
    <div class="flex items-center gap-3">
        <div class="hidden sm:flex w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 items-center justify-center shadow-lg shadow-amber-500/20 flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
        </div>
        <h1 class="text-lg font-bold text-white tracking-tight">Today</h1>
    </div>
</SectionContent>

<p class="text-slate-500 dark:text-slate-400 text-sm mb-6">@DateTime.Today.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture)</p>

@if (TodayTasks is { Count: > 0 })
{
    <div class="flex items-center gap-2 mb-6">
        <span class="chip chip-primary">@TodayTasks.Count(t => !t.IsCompleted) remaining</span>
        @if (TodayTasks.Any(t => t.IsCompleted))
        {
            <span class="chip chip-success">@TodayTasks.Count(t => t.IsCompleted) done</span>
        }
        <button @onclick="() => _hideCompleted = !_hideCompleted"
                class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 flex items-center gap-1 transition-colors ml-auto">
            @if (_hideCompleted)
            {
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                </svg>
                <span>Show completed</span>
            }
            else
            {
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                <span>Hide completed</span>
            }
        </button>
    </div>
}

@if (_loading)
{
    <div class="card dark:bg-slate-800 dark:border-slate-700 overflow-hidden">
        <div class="h-1 bg-gradient-to-r from-brand-500 via-violet-500 to-fuchsia-500 animate-pulse"></div>
        @for (int i = 0; i < 4; i++)
        {
            <div class="task-row">
                <div class="w-5 h-5 rounded bg-slate-200 dark:bg-slate-700 flex-shrink-0 animate-pulse"></div>
                <div class="flex-1 h-4 bg-slate-100 dark:bg-slate-700 rounded-full animate-pulse"></div>
                <div class="w-16 h-5 bg-slate-100 dark:bg-slate-700 rounded-full animate-pulse"></div>
            </div>
        }
    </div>
}
else if (_error is not null)
{
    <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-5 py-4 text-sm font-medium">⚠ @_error</div>
}
else if (TodayTasks is not { Count: > 0 })
{
    <div class="card dark:bg-slate-800 dark:border-slate-700 flex flex-col items-center justify-center py-20 text-center">
        <div class="w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mb-5">
            <svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">All caught up! 🎉</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm">No tasks due today. Enjoy your free time.</p>
    </div>
}
else
{
    <div class="card dark:bg-slate-800 dark:border-slate-700 overflow-hidden">
        <!-- Progress bar -->
        @{
            var pct = TodayTasks.Count > 0 ? (int)(100.0 * TodayTasks.Count(t => t.IsCompleted) / TodayTasks.Count) : 0;
            var visibleTasks = _hideCompleted ? TodayTasks.Where(t => !t.IsCompleted).ToList() : TodayTasks.ToList();
        }
        <div class="h-1.5 bg-slate-100 dark:bg-slate-700">
            <div class="h-full bg-gradient-to-r from-brand-500 to-emerald-500 rounded-r-full transition-all duration-500" style="width: @(pct)%"></div>
        </div>

        @if (visibleTasks.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-12 text-center">
                <div class="text-4xl mb-3">✅</div>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">All tasks completed!</p>
                <button @onclick="() => _hideCompleted = false" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">Show completed tasks</button>
            </div>
        }
        else
        {
            @foreach (var task in visibleTasks)
            {
                <div class="task-row @(task.IsCompleted ? "opacity-50" : "")">
                    <TaskStatusCheckbox TaskId="@task.Id"
                                        ListId="@task.ListId"
                                        IsCompleted="@task.IsCompleted"
                                        TaskTitle="@task.Title"
                                        OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                        OnError="(msg) => Notifications.Add(msg, NotifySeverity.Warning)" />
                    <span class="flex-1 min-w-0 text-sm font-medium text-slate-800 dark:text-slate-200 @(task.IsCompleted ? "line-through text-slate-400 dark:text-slate-500" : "") truncate">
                        @task.Title
                    </span>
                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        <span class="chip chip-info text-xs hidden sm:inline-flex">@task.ListName</span>
                        @if (task.Importance == "High")
                        {
                            <span class="chip chip-error" title="High priority">!</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    [PersistentState]
    public IReadOnlyList<PersistedTodoTaskWithList>? TodayTasks { get; set; }

    private bool _loading = true;
    private bool _hideCompleted = false;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (TodayTasks is not null)
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks restored from persistent state, count={Count}", TodayTasks.Count);
            _loading = false;
            return;
        }

        try
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks not in persistent state, fetching fresh");
            TodayTasks = (await TodoService.GetTodayTasksAsync())
                .Select(t => new PersistedTodoTaskWithList(t.Id, t.Title, t.IsCompleted, t.Importance, t.ListId, t.ListName))
                .ToList();
            Logger.LogDebug("OnInitializedAsync: Fetched {Count} tasks", TodayTasks?.Count ?? 0);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load today's tasks: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        Logger.LogDebug("HandleTaskStatusChanged: TaskId={TaskId}, NewStatus={NewStatus}", taskId, newStatus);
        TodayTasks = TodayTasks!.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }
}
