@page "/today"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<Today> Logger
@inject ISnackbar Snackbar

<PageTitle>Today</PageTitle>

<div class="page-header mb-6">
    <div class="d-flex align-center">
        <div class="page-icon-wrap mr-3" style="background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);">
            <MudIcon Icon="@Icons.Material.Filled.Today" Style="color: #4F46E5;" />
        </div>
        <div>
            <MudText Typo="Typo.h4" Class="page-title">Today</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">@DateTime.Today.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture)</MudText>
        </div>
    </div>
</div>

@if (_loading)
{
    <MudPaper Elevation="2" Class="pa-6" Style="border-radius: 16px;">
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" Rounded="true" />
        @for (int i = 0; i < 4; i++)
        {
            <MudSkeleton Height="52px" Class="mb-2" />
        }
    </MudPaper>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Style="border-radius: 12px;">@_error</MudAlert>
}
else if (TodayTasks is not { Count: > 0 })
{
    <MudPaper Elevation="2" Class="pa-8 d-flex flex-column align-center" Style="border-radius: 16px; text-align: center;">
        <div style="font-size: 3rem; margin-bottom: 16px;">🎉</div>
        <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 600;">All caught up!</MudText>
        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">No tasks due today. Enjoy your free time.</MudText>
    </MudPaper>
}
else
{
    <div class="d-flex align-center mb-4">
        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Style="font-weight: 600; border-radius: 8px;">
            @TodayTasks.Count(t => !t.IsCompleted) remaining
        </MudChip>
        @if (TodayTasks.Any(t => t.IsCompleted))
        {
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ml-2" Style="font-weight: 600; border-radius: 8px;">
                @TodayTasks.Count(t => t.IsCompleted) done
            </MudChip>
        }
    </div>

    <MudPaper Elevation="2" Class="pa-0" Style="border-radius: 16px; overflow: hidden;">
        @foreach (var (task, idx) in TodayTasks.Select((t, i) => (t, i)))
        {
            <div class="today-task-row @(task.IsCompleted ? "task-completed" : "") @(idx > 0 ? "task-divider" : "")">
                <TaskStatusCheckbox TaskId="@task.Id"
                                    ListId="@task.ListId"
                                    IsCompleted="@task.IsCompleted"
                                    TaskTitle="@task.Title"
                                    OnStatusChanged="(newStatus) => HandleTaskStatusChanged(task.Id, newStatus)"
                                    OnError="(msg) => Snackbar.Add(msg, Severity.Warning)" />
                <div class="task-text-wrap">
                    <MudText Style="@(task.IsCompleted ? "text-decoration: line-through; opacity: 0.45;" : "font-weight: 500;")">
                        @task.Title
                    </MudText>
                </div>
                <MudSpacer />
                <div class="d-flex align-center gap-1">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Style="border-radius: 6px; font-size: 0.75rem;">@task.ListName</MudChip>
                    @if (task.Importance == "High")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Style="border-radius: 6px; min-width: 28px;">!</MudChip>
                    }
                </div>
            </div>
        }
    </MudPaper>
}

@code {
    [PersistentState]
    public IReadOnlyList<TodoTaskWithList>? TodayTasks { get; set; }

    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (TodayTasks is not null)
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks restored from persistent state, count={Count}", TodayTasks.Count);
            _loading = false;
            return;
        }

        try
        {
            Logger.LogDebug("OnInitializedAsync: TodayTasks not in persistent state, fetching fresh");
            TodayTasks = await TodoService.GetTodayTasksAsync();
            Logger.LogDebug("OnInitializedAsync: Fetched {Count} tasks", TodayTasks?.Count ?? 0);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load today's tasks: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleTaskStatusChanged(string taskId, bool newStatus)
    {
        Logger.LogDebug("HandleTaskStatusChanged: TaskId={TaskId}, NewStatus={NewStatus}", taskId, newStatus);
        TodayTasks = TodayTasks!.Select(t => t.Id == taskId ? t with { IsCompleted = newStatus } : t).ToList();
    }
}
