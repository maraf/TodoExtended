@page "/sync-settings"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Sync Settings</PageTitle>

<MudText Typo="Typo.h4" Class="page-title mb-1">Sync Settings</MudText>
<MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mb-6">Configure which task lists are synced.</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="pa-2" Style="max-width:480px">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Synced">
                @if (_selectionMode)
                {
                    <div class="d-flex align-center pa-1">
                        <MudCheckBox T="bool"
                                     Value="@(_syncedLists.Count > 0 && _selectedListIds.SetEquals(_syncedLists.Select(l => l.Id)))"
                                     ValueChanged="v => SelectAllSynced(v)"
                                     Label="Select all"
                                     Size="Size.Small"
                                     Dense="true" />
                        <MudSpacer />
                        @if (_selectedListIds.Any(id => _syncedLists.Any(l => l.Id == id)))
                        {
                            <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                                       OnClick="BulkRemoveFromSync" Disabled="_syncingListId is not null">
                                Remove from Sync
                            </MudButton>
                        }
                    </div>
                }
                <MudList T="string" Dense="true">
                    @foreach (var list in _syncedLists)
                    {
                        <MudListItem T="string">
                            <div class="d-flex align-center" style="width:100%">
                                @if (_selectionMode)
                                {
                                    <MudCheckBox T="bool"
                                                 Value="@_selectedListIds.Contains(list.Id)"
                                                 ValueChanged="v => ToggleListSelection(list.Id, v)"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 StopClickPropagation="true"
                                                 Class="mr-1" />
                                }
                                <MudText>@list.DisplayName</MudText>
                                <MudSpacer />
                                @if (_syncingListId == list.Id)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else if (!_selectionMode)
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.SyncDisabled" OnClick="() => RemoveFromSync(list.Id)">Remove from Sync</MudMenuItem>
                                    </MudMenu>
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudTabPanel>
            <MudTabPanel Text="Not Synced" OnClick="EnsureNotSyncedLoaded">
                @if (_loadingNotSynced)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
                }
                else if (_notSyncedLists.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">All lists are synced.</MudText>
                }
                else
                {
                    @if (_selectionMode)
                    {
                        <div class="d-flex align-center pa-1">
                            <MudCheckBox T="bool"
                                         Value="@(_notSyncedLists.Count > 0 && _selectedListIds.SetEquals(_notSyncedLists.Select(l => l.Id)))"
                                         ValueChanged="v => SelectAllNotSynced(v)"
                                         Label="Select all"
                                         Size="Size.Small"
                                         Dense="true" />
                            <MudSpacer />
                            @if (_selectedListIds.Any(id => _notSyncedLists.Any(l => l.Id == id)))
                            {
                                <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                           OnClick="BulkAddToSync" Disabled="_syncingListId is not null">
                                    Add to Sync
                                </MudButton>
                            }
                        </div>
                    }
                    <MudList T="string" Dense="true">
                        @foreach (var list in _notSyncedLists)
                        {
                            <MudListItem T="string">
                                <div class="d-flex align-center" style="width:100%">
                                    @if (_selectionMode)
                                    {
                                        <MudCheckBox T="bool"
                                                     Value="@_selectedListIds.Contains(list.Id)"
                                                     ValueChanged="v => ToggleListSelection(list.Id, v)"
                                                     Size="Size.Small"
                                                     Dense="true"
                                                     StopClickPropagation="true"
                                                     Class="mr-1" />
                                    }
                                    <MudText Color="Color.Secondary">@list.DisplayName</MudText>
                                    <MudSpacer />
                                    @if (_syncingListId == list.Id)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else if (!_selectionMode)
                                    {
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                                            <MudMenuItem Icon="@Icons.Material.Filled.Sync" OnClick="() => AddToSync(list.Id)">Add to Sync</MudMenuItem>
                                        </MudMenu>
                                    }
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudTabPanel>
        </MudTabs>
        <div class="d-flex justify-end pa-1">
            <MudTooltip Text="@(_selectionMode ? "Exit selection" : "Select multiple lists")">
                <MudToggleIconButton Toggled="_selectionMode"
                                     Icon="@Icons.Material.Filled.CheckBox"
                                     ToggledIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                                     Size="Size.Small"
                                     ToggledChanged="OnSelectionModeChanged" />
            </MudTooltip>
        </div>
    </MudPaper>
}

@code {
    private IReadOnlyList<TodoTaskList> _syncedLists = [];
    private IReadOnlyList<TodoTaskList> _notSyncedLists = [];
    private bool _loading = true;
    private bool _loadingNotSynced;
    private bool _notSyncedListsLoaded;
    private string? _error;
    private string? _syncingListId;
    private bool _selectionMode;
    private HashSet<string> _selectedListIds = [];
    private const string BulkOperationId = "bulk";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _syncedLists = await TodoService.GetTaskListsAsync();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load task lists: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EnsureNotSyncedLoaded()
    {
        if (!_notSyncedListsLoaded)
        {
            await LoadNotSyncedLists();
        }
    }

    private async Task LoadNotSyncedLists()
    {
        _loadingNotSynced = true;
        try
        {
            _notSyncedLists = await TodoService.GetNotSyncedTaskListsAsync();
            _notSyncedListsLoaded = true;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load not-synced lists: {ex.Message}";
        }
        finally
        {
            _loadingNotSynced = false;
        }
    }

    private async Task RemoveFromSync(string listId)
    {
        if (_syncingListId is not null) return;
        _syncingListId = listId;

        try
        {
            await TodoService.SetTaskListSyncedAsync(listId, false);

            var list = _syncedLists.First(l => l.Id == listId);
            _syncedLists = _syncedLists.Where(l => l.Id != listId).ToList();
            _notSyncedLists = [.. _notSyncedLists, list with { IsSynced = false }];

            Snackbar.Add($"List \"{list.DisplayName}\" removed from sync.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to remove list from sync: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncingListId = null;
        }
    }

    private async Task AddToSync(string listId)
    {
        if (_syncingListId is not null) return;
        _syncingListId = listId;

        try
        {
            await TodoService.SetTaskListSyncedAsync(listId, true);

            var list = _notSyncedLists.First(l => l.Id == listId);
            _notSyncedLists = _notSyncedLists.Where(l => l.Id != listId).ToList();
            _syncedLists = [.. _syncedLists, list with { IsSynced = true }];

            Snackbar.Add($"List \"{list.DisplayName}\" added to sync.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to add list to sync: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncingListId = null;
        }
    }

    private void ToggleListSelection(string listId, bool selected)
    {
        if (selected)
            _selectedListIds.Add(listId);
        else
            _selectedListIds.Remove(listId);
    }

    private void SelectAllSynced(bool selectAll)
    {
        if (selectAll)
            foreach (var list in _syncedLists)
                _selectedListIds.Add(list.Id);
        else
            foreach (var list in _syncedLists)
                _selectedListIds.Remove(list.Id);
    }

    private void SelectAllNotSynced(bool selectAll)
    {
        if (selectAll)
            foreach (var list in _notSyncedLists)
                _selectedListIds.Add(list.Id);
        else
            foreach (var list in _notSyncedLists)
                _selectedListIds.Remove(list.Id);
    }

    private void OnSelectionModeChanged(bool toggled)
    {
        _selectionMode = toggled;
        if (!toggled)
            _selectedListIds.Clear();
    }

    private async Task BulkRemoveFromSync()
    {
        var ids = _selectedListIds.Where(id => _syncedLists.Any(l => l.Id == id)).ToList();
        if (ids.Count == 0) return;

        _syncingListId = BulkOperationId;
        try
        {
            await Task.WhenAll(ids.Select(id => TodoService.SetTaskListSyncedAsync(id, false)));

            var listsToMove = _syncedLists.Where(l => ids.Contains(l.Id)).ToList();
            _syncedLists = _syncedLists.Where(l => !ids.Contains(l.Id)).ToList();
            _notSyncedLists = [.. _notSyncedLists, .. listsToMove.Select(l => l with { IsSynced = false })];

            _selectedListIds.ExceptWith(ids);
            Snackbar.Add($"{listsToMove.Count} list(s) removed from sync.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update sync: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncingListId = null;
        }
    }

    private async Task BulkAddToSync()
    {
        var ids = _selectedListIds.Where(id => _notSyncedLists.Any(l => l.Id == id)).ToList();
        if (ids.Count == 0) return;

        _syncingListId = BulkOperationId;
        try
        {
            await Task.WhenAll(ids.Select(id => TodoService.SetTaskListSyncedAsync(id, true)));

            var listsToMove = _notSyncedLists.Where(l => ids.Contains(l.Id)).ToList();
            _notSyncedLists = _notSyncedLists.Where(l => !ids.Contains(l.Id)).ToList();
            _syncedLists = [.. _syncedLists, .. listsToMove.Select(l => l with { IsSynced = true })];

            _selectedListIds.ExceptWith(ids);
            Snackbar.Add($"{listsToMove.Count} list(s) added to sync.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update sync: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncingListId = null;
        }
    }
}
