@page "/templates"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Data
@inject ITemplateService TemplateService
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject INotificationService Notifications
@inject IJSRuntime JS

<PageTitle>Templates</PageTitle>

<SectionContent SectionName="page-header">
    <div class="flex items-center gap-3">
        <div class="hidden sm:flex w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 items-center justify-center shadow-lg shadow-violet-500/20 flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
        </div>
        <h1 class="text-lg font-bold text-white tracking-tight">Templates</h1>
    </div>
</SectionContent>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <p class="text-slate-500 dark:text-slate-400 text-sm">Manage templates for quick task creation.</p>
    @if (!_loading && _error is null)
    {
        <button @onclick="OpenAddDialog" class="btn-primary flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Template
        </button>
    }
</div>

@if (_loading)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @for (var i = 0; i < 3; i++)
        {
            <div class="h-40 bg-slate-100 dark:bg-slate-800 rounded-2xl animate-pulse"></div>
        }
    </div>
}
else if (_error is not null)
{
    <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-5 py-4 text-sm font-medium">⚠ @_error</div>
}
else if (TemplateItems is not { Count: > 0 })
{
    <div class="card dark:bg-slate-800 dark:border-slate-700 flex flex-col items-center justify-center py-20 text-center border-2 border-dashed">
        <div class="text-5xl mb-4">📝</div>
        <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">No templates yet</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Create templates to quickly add recurring tasks.</p>
        <button @onclick="OpenAddDialog" class="btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Create First Template
        </button>
    </div>
}
else
{
    @foreach (var group in TemplateItems.GroupBy(t => t.TaskListName).OrderBy(g => g.Key))
    {
        <div class="mb-8">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-3">@group.Key</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var template in group.OrderBy(t => t.SortOrder).ThenBy(t => t.Title))
                {
                    var tmpl = template;
                    <div class="card-hover dark:bg-slate-800 dark:border-slate-700 p-5 relative flex flex-col">
                        @if (tmpl.SortOrder != 0)
                        {
                            <span class="absolute top-3 right-3 w-5 h-5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 text-xs font-bold flex items-center justify-center">@tmpl.SortOrder</span>
                        }
                        <div class="flex items-start justify-between gap-2 mb-4">
                            <div class="flex-1 min-w-0">
                                <h3 class="font-bold text-slate-900 dark:text-white text-sm leading-tight">@tmpl.Title</h3>
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">@tmpl.TaskListName</p>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-1.5 mb-4">
                            @if (tmpl.DueDateToday)
                            {
                                <span class="chip chip-warning">⏰ Due Today</span>
                            }
                            @if (tmpl.ReminderTime is not null)
                            {
                                <span class="chip chip-info">🔔 @tmpl.ReminderTime.Value.ToString("HH:mm")</span>
                            }
                        </div>
                        <div class="flex-1"></div>
                        <div class="flex gap-2">
                            <button @onclick="() => CreateTaskFromTemplate(tmpl)" class="btn-primary btn-sm flex-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                                Create
                            </button>
                            <button @onclick="() => OpenEditDialog(tmpl)" class="btn-ghost btn-sm" title="Edit">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </button>
                            <button @onclick="() => PromptDelete(tmpl.Id)" class="btn-ghost btn-sm text-rose-500 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/30" title="Delete">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<!-- Add/Edit Modal -->
@if (_dialogVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @onclick="CloseDialog"></div>
        <div class="relative bg-white dark:bg-slate-800 rounded-3xl shadow-2xl w-full max-w-md border border-slate-100 dark:border-slate-700 animate-fade-in">
            <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100 dark:border-slate-700">
                <h2 class="text-lg font-bold text-slate-900 dark:text-white">@(_editingTemplateId is not null ? "Edit Template" : "New Template")</h2>
                <button @onclick="CloseDialog" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="px-6 py-5 space-y-4">
                <div class="floating-field">
                    <input @bind="_formTitle" @bind:event="oninput" type="text" placeholder=" " class="floating-input" />
                    <label class="floating-label">Title</label>
                </div>
                <div class="floating-field">
                    <select @bind="_formTaskListId" class="floating-select">
                        <option value="">Select a list…</option>
                        @if (TaskLists is not null)
                        {
                            @foreach (var list in TaskLists)
                            {
                                <option value="@list.Id">@list.DisplayName</option>
                            }
                        }
                    </select>
                    <label class="floating-label">Task List</label>
                </div>
                <div class="floating-field w-28">
                    <input @bind="_formSortOrder" type="number" placeholder=" " class="floating-input" />
                    <label class="floating-label">Sort Order</label>
                </div>
                <div class="flex items-center gap-3">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" class="sr-only peer" checked="@_formDueDateToday" @onchange="e => OnDueDateTodayChanged((bool)(e.Value ?? false))" />
                        <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-600"></div>
                    </label>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Due Today</span>
                </div>
                @if (_formDueDateToday)
                {
                    <div class="floating-field">
                        <input value="@_formReminderTime" @onchange="e => _formReminderTime = e.Value?.ToString()" type="time" placeholder=" " class="floating-input" />
                        <label class="floating-label">Reminder Time (optional)</label>
                    </div>
                }
                @if (_formError is not null)
                {
                    <div class="rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-4 py-3 text-sm">@_formError</div>
                }
            </div>
            <div class="flex justify-end gap-3 px-6 py-4 border-t border-slate-100 dark:border-slate-700">
                <button @onclick="CloseDialog" class="btn-ghost">Cancel</button>
                <button @onclick="SaveTemplate" disabled="@_saving" class="btn-primary">
                    @if (_saving)
                    {
                        <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                    }
                    @(_editingTemplateId is not null ? "Update" : "Create")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [PersistentState]
    public IReadOnlyList<TaskTemplate>? TemplateItems { get; set; }

    [PersistentState]
    public IReadOnlyList<TodoTaskList>? TaskLists { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _formError;
    private bool _dialogVisible;

    private string _formTitle = "";
    private string _formTaskListId = "";
    private bool _formDueDateToday;
    private string? _formReminderTime;
    private int _formSortOrder;
    private Guid? _editingTemplateId;

    protected override async Task OnInitializedAsync()
    {
        if (TemplateItems is not null)
        {
            _loading = false;
            return;
        }

        try
        {
            var templatesTask = TemplateService.GetAllAsync();
            var taskListsTask = TodoService.GetTaskListsAsync();
            await Task.WhenAll(templatesTask, taskListsTask);

            TemplateItems = templatesTask.Result.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
            TaskLists = taskListsTask.Result;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenAddDialog()
    {
        ResetForm();
        _dialogVisible = true;
    }

    private void OpenEditDialog(TaskTemplate template)
    {
        _editingTemplateId = template.Id;
        _formTitle = template.Title;
        _formTaskListId = template.TaskListId;
        _formDueDateToday = template.DueDateToday;
        _formReminderTime = template.ReminderTime?.ToString("HH:mm");
        _formSortOrder = template.SortOrder;
        _formError = null;
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
        ResetForm();
    }

    private async Task SaveTemplate()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "Title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formTaskListId))
        {
            _formError = "Please select a task list.";
            return;
        }

        var selectedList = TaskLists?.FirstOrDefault(l => l.Id == _formTaskListId);
        if (selectedList is null)
        {
            _formError = "Invalid task list selection.";
            return;
        }

        TimeOnly? reminderTime = null;
        if (_formDueDateToday && !string.IsNullOrEmpty(_formReminderTime)
            && TimeOnly.TryParseExact(_formReminderTime, "HH:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var t))
        {
            reminderTime = t;
        }

        _saving = true;

        try
        {
            if (_editingTemplateId is not null)
            {
                var existing = await TemplateService.GetByIdAsync(_editingTemplateId.Value);
                if (existing is not null)
                {
                    existing.Title = _formTitle.Trim();
                    existing.TaskListId = selectedList.Id;
                    existing.TaskListName = selectedList.DisplayName;
                    existing.DueDateToday = _formDueDateToday;
                    existing.ReminderTime = reminderTime;
                    existing.SortOrder = _formSortOrder;
                    await TemplateService.UpdateAsync(existing);
                }

                Notifications.Add("Template updated.", NotifySeverity.Success);
            }
            else
            {
                var template = new TaskTemplate
                {
                    Title = _formTitle.Trim(),
                    TaskListId = selectedList.Id,
                    TaskListName = selectedList.DisplayName,
                    DueDateToday = _formDueDateToday,
                    ReminderTime = reminderTime,
                    SortOrder = _formSortOrder
                };
                await TemplateService.CreateAsync(template);
                Notifications.Add("Template created.", NotifySeverity.Success);
            }

            await RefreshTemplates();
            _dialogVisible = false;
            ResetForm();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to save template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CreateTaskFromTemplate(TaskTemplate template)
    {
        try
        {
            DateOnly? dueDate = template.DueDateToday ? DateOnly.FromDateTime(DateTime.Today) : null;
            await TodoService.CreateTaskAsync(template.TaskListId, template.Title, dueDate, template.ReminderTime);
            Notifications.Add($"Task \"{template.Title}\" created.", NotifySeverity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Notifications.Add($"Failed to create task: {ex.Message}", NotifySeverity.Error);
        }
    }

    private async Task PromptDelete(Guid templateId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this template?");
        if (confirmed)
        {
            await ConfirmDelete(templateId);
        }
    }

    private async Task ConfirmDelete(Guid templateId)
    {
        try
        {
            await TemplateService.DeleteAsync(templateId);
            await RefreshTemplates();
            Notifications.Add("Template deleted.", NotifySeverity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Notifications.Add($"Failed to delete: {ex.Message}", NotifySeverity.Error);
        }
    }

    private async Task RefreshTemplates()
    {
        var all = await TemplateService.GetAllAsync();
        TemplateItems = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
    }

    private void ResetForm()
    {
        _editingTemplateId = null;
        _formTitle = "";
        _formTaskListId = "";
        _formDueDateToday = false;
        _formReminderTime = null;
        _formSortOrder = 0;
        _formError = null;
    }

    private void OnDueDateTodayChanged(bool value)
    {
        _formDueDateToday = value;
        if (!value) _formReminderTime = null;
    }
}
