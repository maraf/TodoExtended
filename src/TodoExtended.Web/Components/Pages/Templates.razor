@page "/templates"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Data
@inject ITemplateService TemplateService
@inject ITodoService TodoService
@inject NavigationManager NavigationManager

<PageTitle>Templates</PageTitle>

<Heading Tag="HeadingTag.H1" class="mb-6">Templates</Heading>

@if (_loading)
{
    <div class="flex items-center gap-2">
        <Spinner Size="SpinnerSize.Sm" Color="SpinnerColor.Info" />
        <span class="text-gray-500 dark:text-gray-400">Loading templates...</span>
    </div>
}
else if (_error is not null)
{
    <Alert Color="AlertColor.Failure">
        <CustomContent>@_error</CustomContent>
    </Alert>
}
else
{
    <Card class="mb-6">
        <Heading Tag="HeadingTag.H5" class="mb-4">@(_editingTemplateId is not null ? "Edit Template" : "Add Template")</Heading>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-3">
                <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Title</label>
                <input type="text" @bind="_formTitle" placeholder="Task title"
                       class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" />
            </div>
            <div class="md:col-span-3">
                <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Task List</label>
                <select @bind="_formTaskListId"
                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                    <option value="">-- Select a list --</option>
                    @if (_taskLists is not null)
                    {
                        @foreach (var list in _taskLists)
                        {
                            <option value="@list.Id">@list.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Sort Order</label>
                <input type="number" @bind="_formSortOrder"
                       class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" />
            </div>
            <div class="md:col-span-2 flex items-center gap-2 pb-1">
                <input type="checkbox" id="dueDateToday" @bind="_formDueDateToday"
                       class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" />
                <label for="dueDateToday" class="text-sm font-medium text-gray-900 dark:text-white">Due Today</label>
            </div>
            <div class="md:col-span-2 flex gap-2">
                <Button Color="ButtonColor.Green" OnClick="SaveTemplate" Disabled="@_saving" Loading="@_saving">
                    @(_editingTemplateId is not null ? "Update" : "Add")
                </Button>
                @if (_editingTemplateId is not null)
                {
                    <Button Color="ButtonColor.Gray" OnClick="CancelEdit">Cancel</Button>
                }
            </div>
        </div>

        @if (_formError is not null)
        {
            <Alert Color="AlertColor.Failure" class="mt-4">
                <CustomContent>@_formError</CustomContent>
            </Alert>
        }
    </Card>

    @if (_templates is { Count: > 0 })
    {
        <Table Striped="true" Hoverable="true">
            <TableHead>
                <TableRow>
                    <TableHeadCell>Title</TableHeadCell>
                    <TableHeadCell>Task List</TableHeadCell>
                    <TableHeadCell>Due Today</TableHeadCell>
                    <TableHeadCell>Sort Order</TableHeadCell>
                    <TableHeadCell><span class="sr-only">Actions</span></TableHeadCell>
                </TableRow>
            </TableHead>
            <TableBody class="divide-y">
                @foreach (var template in _templates)
                {
                    <TableRow class="bg-white dark:border-gray-700 dark:bg-gray-800">
                        <TableCell>@template.Title</TableCell>
                        <TableCell>@template.TaskListName</TableCell>
                        <TableCell>
                            @if (template.DueDateToday)
                            {
                                <Badge Color="BadgeColor.Success">Yes</Badge>
                            }
                            else
                            {
                                <span class="text-gray-500 dark:text-gray-400">No</span>
                            }
                        </TableCell>
                        <TableCell>@template.SortOrder</TableCell>
                        <TableCell>
                            <div class="flex gap-2">
                                <Button Size="ButtonSize.Small" Color="ButtonColor.Primary" OnClick="() => StartEdit(template)">Edit</Button>
                                @if (_deleteConfirmId == template.Id)
                                {
                                    <Button Size="ButtonSize.Small" Color="ButtonColor.Red" OnClick="() => ConfirmDelete(template.Id)">Confirm</Button>
                                    <Button Size="ButtonSize.Small" Color="ButtonColor.Gray" OnClick="() => _deleteConfirmId = null">Cancel</Button>
                                }
                                else
                                {
                                    <Button Size="ButtonSize.Small" Color="ButtonColor.Red" OnClick="() => _deleteConfirmId = template.Id">Delete</Button>
                                }
                            </div>
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
    else
    {
        <Paragraph class="text-gray-500 dark:text-gray-400">No templates yet. Create one above!</Paragraph>
    }
}

@code {
    private IReadOnlyList<TaskTemplate>? _templates;
    private IReadOnlyList<TodoTaskList>? _taskLists;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _formError;
    private int? _deleteConfirmId;

    // Form fields
    private string _formTitle = "";
    private string _formTaskListId = "";
    private bool _formDueDateToday;
    private int _formSortOrder;
    private int? _editingTemplateId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var templatesTask = TemplateService.GetAllAsync();
            var taskListsTask = TodoService.GetTaskListsAsync();
            await Task.WhenAll(templatesTask, taskListsTask);

            _templates = templatesTask.Result.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
            _taskLists = taskListsTask.Result;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveTemplate()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "Title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formTaskListId))
        {
            _formError = "Please select a task list.";
            return;
        }

        var selectedList = _taskLists?.FirstOrDefault(l => l.Id == _formTaskListId);
        if (selectedList is null)
        {
            _formError = "Invalid task list selection.";
            return;
        }

        _saving = true;

        try
        {
            if (_editingTemplateId is not null)
            {
                var existing = await TemplateService.GetByIdAsync(_editingTemplateId.Value);
                if (existing is not null)
                {
                    existing.Title = _formTitle.Trim();
                    existing.TaskListId = selectedList.Id;
                    existing.TaskListName = selectedList.DisplayName;
                    existing.DueDateToday = _formDueDateToday;
                    existing.SortOrder = _formSortOrder;
                    await TemplateService.UpdateAsync(existing);
                }
            }
            else
            {
                var template = new TaskTemplate
                {
                    Title = _formTitle.Trim(),
                    TaskListId = selectedList.Id,
                    TaskListName = selectedList.DisplayName,
                    DueDateToday = _formDueDateToday,
                    SortOrder = _formSortOrder
                };
                await TemplateService.CreateAsync(template);
            }

            await RefreshTemplates();
            ResetForm();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to save template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEdit(TaskTemplate template)
    {
        _editingTemplateId = template.Id;
        _formTitle = template.Title;
        _formTaskListId = template.TaskListId;
        _formDueDateToday = template.DueDateToday;
        _formSortOrder = template.SortOrder;
        _formError = null;
        _deleteConfirmId = null;
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private async Task ConfirmDelete(int templateId)
    {
        try
        {
            await TemplateService.DeleteAsync(templateId);
            await RefreshTemplates();
            _deleteConfirmId = null;

            if (_editingTemplateId == templateId)
            {
                ResetForm();
            }
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to delete template: {ex.Message}";
        }
    }

    private async Task RefreshTemplates()
    {
        var all = await TemplateService.GetAllAsync();
        _templates = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
    }

    private void ResetForm()
    {
        _editingTemplateId = null;
        _formTitle = "";
        _formTaskListId = "";
        _formDueDateToday = false;
        _formSortOrder = 0;
        _formError = null;
    }
}
