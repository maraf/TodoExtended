@page "/templates"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Data
@inject ITemplateService TemplateService
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Templates</PageTitle>

@* Header row with title and add button *@
<div class="d-flex align-center justify-space-between mb-6">
    <MudText Typo="Typo.h4">Templates</MudText>
    @if (!_loading && _error is null)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog">
            New Template
        </MudButton>
    }
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    <MudGrid Spacing="4">
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Class="rounded-lg" />
            </MudItem>
        }
    </MudGrid>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (TemplateItems is not { Count: > 0 })
{
    @* Empty state *@
    <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center pa-12 mt-4" Style="border: 2px dashed var(--mud-palette-lines-default); border-radius: 12px;">
        <MudIcon Icon="@Icons.Material.Filled.ContentPaste" Size="Size.Large" Color="Color.Secondary" Class="mb-4" Style="font-size: 4rem;" />
        <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-2">No templates yet</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">Create templates to quickly add recurring tasks with a single click.</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Large"
                   OnClick="OpenAddDialog">
            Create Your First Template
        </MudButton>
    </MudPaper>
}
else
{
    @* Group templates by task list *@
    @foreach (var group in TemplateItems.GroupBy(t => t.TaskListName).OrderBy(g => g.Key))
    {
        <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2 mt-4">
            @group.Key
        </MudText>

        <MudGrid Spacing="3" Class="mb-2">
            @foreach (var template in group.OrderBy(t => t.SortOrder).ThenBy(t => t.Title))
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2" Class="template-card" Style="position: relative; height: 100%;">
                        @* Sort order badge *@
                        @if (template.SortOrder != 0)
                        {
                            <MudBadge Content="@template.SortOrder"
                                      Color="Color.Default"
                                      Overlap="true"
                                      Origin="Origin.TopRight"
                                      Class="template-sort-badge">
                                <span></span>
                            </MudBadge>
                        }
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@template.Title</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                         Size="Size.Small"
                                         AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.AddTask"
                                                 IconColor="Color.Primary"
                                                 OnClick="() => CreateTaskFromTemplate(template)">
                                        Create Task
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                 OnClick="() => OpenEditDialog(template)">
                                        Edit
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                 IconColor="Color.Error"
                                                 OnClick="() => PromptDelete(template.Id)">
                                        Delete
                                    </MudMenuItem>
                                </MudMenu>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent Class="pt-0">
                            <div class="d-flex gap-2 flex-wrap">
                                @if (template.DueDateToday)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Warning"
                                             Icon="@Icons.Material.Filled.Today"
                                             Variant="Variant.Filled">
                                        Due Today
                                    </MudChip>
                                }
                                @if (template.ReminderTime is not null)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Info"
                                             Icon="@Icons.Material.Filled.Alarm"
                                             Variant="Variant.Filled">
                                        @template.ReminderTime.Value.ToString("HH:mm")
                                    </MudChip>
                                }
                                @if (template.SortOrder != 0)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Default"
                                             Variant="Variant.Outlined">
                                        Order: @template.SortOrder
                                    </MudChip>
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@* Add/Edit Dialog *@
<MudDialog @bind-Visible="_dialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_editingTemplateId is not null ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" Style="vertical-align: middle;" />
            @(_editingTemplateId is not null ? "Edit Template" : "New Template")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_formTitle"
                      Label="Title"
                      Placeholder="e.g. Morning standup notes"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      Immediate="true" />

        <MudSelect T="string"
                   @bind-Value="_formTaskListId"
                   Label="Task List"
                   Variant="Variant.Outlined"
                   Placeholder="Select a list"
                   Class="mb-4">
            @if (TaskLists is not null)
            {
                @foreach (var list in TaskLists)
                {
                    <MudSelectItem T="string" Value="@list.Id">@list.DisplayName</MudSelectItem>
                }
            }
        </MudSelect>

        <MudGrid Spacing="3" Class="mb-2">
            <MudItem xs="3">
                <MudNumericField @bind-Value="_formSortOrder"
                                 Label="Sort Order"
                                 Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudSwitch Value="_formDueDateToday"
                    ValueChanged="OnDueDateTodayChanged"
                    Label="Due Today"
                    Color="Color.Warning"
                    T="bool" />

        @if (_formDueDateToday)
        {
            <MudTimePicker @bind-Time="_formReminderTimeSpan"
                        Label="Reminder Time"
                        Variant="Variant.Outlined"
                        Clearable="true"
                        Class="mb-4"
                        HelperText="Optional — set a reminder for today at this time" />
        }

        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_formError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveTemplate"
                   Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(_editingTemplateId is not null ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .template-card:hover {
        transform: translateY(-2px);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .template-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .template-sort-badge {
        position: absolute;
        top: 8px;
        right: 8px;
    }
</style>

@code {
    [PersistentState]
    public IReadOnlyList<TaskTemplate>? TemplateItems { get; set; }

    [PersistentState]
    public IReadOnlyList<TodoTaskList>? TaskLists { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _formError;
    private bool _dialogVisible;

    // Form fields
    private string _formTitle = "";
    private string _formTaskListId = "";
    private bool _formDueDateToday;
    private TimeSpan? _formReminderTimeSpan;
    private int _formSortOrder;
    private Guid? _editingTemplateId;

    protected override async Task OnInitializedAsync()
    {
        if (TemplateItems is not null)
        {
            _loading = false;
            return;
        }

        try
        {
            var templatesTask = TemplateService.GetAllAsync();
            var taskListsTask = TodoService.GetTaskListsAsync();
            await Task.WhenAll(templatesTask, taskListsTask);

            TemplateItems = templatesTask.Result.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
            TaskLists = taskListsTask.Result;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenAddDialog()
    {
        ResetForm();
        _dialogVisible = true;
    }

    private void OpenEditDialog(TaskTemplate template)
    {
        _editingTemplateId = template.Id;
        _formTitle = template.Title;
        _formTaskListId = template.TaskListId;
        _formDueDateToday = template.DueDateToday;
        _formReminderTimeSpan = template.ReminderTime?.ToTimeSpan();
        _formSortOrder = template.SortOrder;
        _formError = null;
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
        ResetForm();
    }

    private async Task SaveTemplate()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "Title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formTaskListId))
        {
            _formError = "Please select a task list.";
            return;
        }

        var selectedList = TaskLists?.FirstOrDefault(l => l.Id == _formTaskListId);
        if (selectedList is null)
        {
            _formError = "Invalid task list selection.";
            return;
        }

        _saving = true;

        try
        {
            if (_editingTemplateId is not null)
            {
                var existing = await TemplateService.GetByIdAsync(_editingTemplateId.Value);
                if (existing is not null)
                {
                    existing.Title = _formTitle.Trim();
                    existing.TaskListId = selectedList.Id;
                    existing.TaskListName = selectedList.DisplayName;
                    existing.DueDateToday = _formDueDateToday;
                    existing.ReminderTime = _formDueDateToday && _formReminderTimeSpan.HasValue
                        ? TimeOnly.FromTimeSpan(_formReminderTimeSpan.Value) : null;
                    existing.SortOrder = _formSortOrder;
                    await TemplateService.UpdateAsync(existing);
                }

                Snackbar.Add("Template updated.", Severity.Success);
            }
            else
            {
                var template = new TaskTemplate
                {
                    Title = _formTitle.Trim(),
                    TaskListId = selectedList.Id,
                    TaskListName = selectedList.DisplayName,
                    DueDateToday = _formDueDateToday,
                    ReminderTime = _formDueDateToday && _formReminderTimeSpan.HasValue
                        ? TimeOnly.FromTimeSpan(_formReminderTimeSpan.Value) : null,
                    SortOrder = _formSortOrder
                };
                await TemplateService.CreateAsync(template);
                Snackbar.Add("Template created.", Severity.Success);
            }

            await RefreshTemplates();
            _dialogVisible = false;
            ResetForm();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to save template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CreateTaskFromTemplate(TaskTemplate template)
    {
        try
        {
            DateOnly? dueDate = template.DueDateToday ? DateOnly.FromDateTime(DateTime.Today) : null;
            await TodoService.CreateTaskAsync(template.TaskListId, template.Title, dueDate, template.ReminderTime);
            Snackbar.Add($"Task \"{template.Title}\" created.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create task: {ex.Message}", Severity.Error);
        }
    }

    private async Task PromptDelete(Guid templateId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Template",
            "Are you sure you want to delete this template?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ConfirmDelete(templateId);
        }
    }

    private async Task ConfirmDelete(Guid templateId)
    {
        try
        {
            await TemplateService.DeleteAsync(templateId);
            await RefreshTemplates();
            Snackbar.Add("Template deleted.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete: {ex.Message}", Severity.Error);
        }
    }

    private async Task RefreshTemplates()
    {
        var all = await TemplateService.GetAllAsync();
        TemplateItems = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
    }

    private void ResetForm()
    {
        _editingTemplateId = null;
        _formTitle = "";
        _formTaskListId = "";
        _formDueDateToday = false;
        _formReminderTimeSpan = null;
        _formSortOrder = 0;
        _formError = null;
    }

    private void OnDueDateTodayChanged(bool value)
    {
        _formDueDateToday = value;
        if (!value)
        {
            _formReminderTimeSpan = null;
        }
    }
}
