@page "/templates"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Data
@inject ITemplateService TemplateService
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Templates</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Templates</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="pa-4 mb-6">
        <MudText Typo="Typo.h6" Class="mb-4">@(_editingTemplateId is not null ? "Edit Template" : "Add Template")</MudText>

        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_formTitle" Label="Title" Placeholder="Task title" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_formTaskListId" Label="Task List" Variant="Variant.Outlined" Placeholder="-- Select a list --">
                    @if (_taskLists is not null)
                    {
                        @foreach (var list in _taskLists)
                        {
                            <MudSelectItem T="string" Value="@list.Id">@list.DisplayName</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="_formSortOrder" Label="Sort Order" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudSwitch @bind-Value="_formDueDateToday" Label="Due Today" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTemplate" Disabled="@_saving">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @(_editingTemplateId is not null ? "Update" : "Add")
                </MudButton>
                @if (_editingTemplateId is not null)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Cancel</MudButton>
                }
            </MudItem>
        </MudGrid>

        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_formError</MudAlert>
        }
    </MudPaper>

    @if (_templates is { Count: > 0 })
    {
        <MudDataGrid T="TaskTemplate" Items="@_templates" Striped="true" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.Title" Title="Title" />
                <PropertyColumn Property="x => x.TaskListName" Title="Task List" />
                <TemplateColumn Title="Due Today">
                    <CellTemplate>
                        @if (context.Item.DueDateToday)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Yes</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.SortOrder" Title="Sort Order" />
                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => StartEdit(context.Item)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => PromptDelete(context.Item.Id)" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
    else
    {
        <MudAlert Severity="Severity.Info">No templates yet. Create one above!</MudAlert>
    }
}

@code {
    private IReadOnlyList<TaskTemplate>? _templates;
    private IReadOnlyList<TodoTaskList>? _taskLists;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _formError;

    // Form fields
    private string _formTitle = "";
    private string _formTaskListId = "";
    private bool _formDueDateToday;
    private int _formSortOrder;
    private int? _editingTemplateId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var templatesTask = TemplateService.GetAllAsync();
            var taskListsTask = TodoService.GetTaskListsAsync();
            await Task.WhenAll(templatesTask, taskListsTask);

            _templates = templatesTask.Result.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
            _taskLists = taskListsTask.Result;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveTemplate()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formTitle))
        {
            _formError = "Title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_formTaskListId))
        {
            _formError = "Please select a task list.";
            return;
        }

        var selectedList = _taskLists?.FirstOrDefault(l => l.Id == _formTaskListId);
        if (selectedList is null)
        {
            _formError = "Invalid task list selection.";
            return;
        }

        _saving = true;

        try
        {
            if (_editingTemplateId is not null)
            {
                var existing = await TemplateService.GetByIdAsync(_editingTemplateId.Value);
                if (existing is not null)
                {
                    existing.Title = _formTitle.Trim();
                    existing.TaskListId = selectedList.Id;
                    existing.TaskListName = selectedList.DisplayName;
                    existing.DueDateToday = _formDueDateToday;
                    existing.SortOrder = _formSortOrder;
                    await TemplateService.UpdateAsync(existing);
                }
            }
            else
            {
                var template = new TaskTemplate
                {
                    Title = _formTitle.Trim(),
                    TaskListId = selectedList.Id,
                    TaskListName = selectedList.DisplayName,
                    DueDateToday = _formDueDateToday,
                    SortOrder = _formSortOrder
                };
                await TemplateService.CreateAsync(template);
            }

            await RefreshTemplates();
            ResetForm();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to save template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEdit(TaskTemplate template)
    {
        _editingTemplateId = template.Id;
        _formTitle = template.Title;
        _formTaskListId = template.TaskListId;
        _formDueDateToday = template.DueDateToday;
        _formSortOrder = template.SortOrder;
        _formError = null;
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private async Task PromptDelete(int templateId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Template",
            "Are you sure you want to delete this template?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ConfirmDelete(templateId);
        }
    }

    private async Task ConfirmDelete(int templateId)
    {
        try
        {
            await TemplateService.DeleteAsync(templateId);
            await RefreshTemplates();

            if (_editingTemplateId == templateId)
            {
                ResetForm();
            }

            Snackbar.Add("Template deleted.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to delete template: {ex.Message}";
        }
    }

    private async Task RefreshTemplates()
    {
        var all = await TemplateService.GetAllAsync();
        _templates = all.OrderBy(t => t.SortOrder).ThenBy(t => t.Title).ToList();
    }

    private void ResetForm()
    {
        _editingTemplateId = null;
        _formTitle = "";
        _formTaskListId = "";
        _formDueDateToday = false;
        _formSortOrder = 0;
        _formError = null;
    }
}
