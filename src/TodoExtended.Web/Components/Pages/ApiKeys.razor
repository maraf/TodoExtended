@page "/api-keys"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Services
@inject IApiKeyService ApiKeyService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>API Keys</PageTitle>

@* Header row with title and add button *@
<div class="d-flex align-center justify-space-between mb-6">
    <div class="d-flex align-center">
        <div class="page-icon-wrap mr-3" style="background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);">
            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Style="color: #059669;" />
        </div>
        <div>
            <MudText Typo="Typo.h4" Class="page-title">API Keys</MudText>
            <MudText Typo="Typo.subtitle1" Style="color: var(--mud-palette-text-secondary);">Manage keys for external integrations.</MudText>
        </div>
    </div>
    @if (!_loading && _error is null)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog"
                   Style="border-radius: 10px; font-weight: 600;">
            New API Key
        </MudButton>
    }
</div>

@if (_newlyCreatedKey is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-6" Variant="Variant.Filled" ShowCloseIcon="true" CloseIconClicked="() => _newlyCreatedKey = null">
        <MudText Typo="Typo.subtitle1" Class="mb-1"><strong>Copy this key now!</strong> It will only be shown once.</MudText>
        <MudTextField Value="@_newlyCreatedKey" ReadOnly="true" Variant="Variant.Outlined"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="CopyKeyToClipboard" Class="mt-2"
                      Style="background: rgba(255,255,255,0.15); border-radius: 4px;" />
    </MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    <MudGrid Spacing="4">
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" Class="rounded-lg" />
            </MudItem>
        }
    </MudGrid>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_apiKeys is not { Count: > 0 })
{
    @* Empty state *@
    <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center pa-12 mt-4" Style="border: 2px dashed var(--mud-palette-lines-default); border-radius: 12px;">
        <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Large" Color="Color.Secondary" Class="mb-4" Style="font-size: 4rem;" />
        <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-2">No API keys yet</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">Create API keys to access your tasks from external tools and integrations.</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Large"
                   OnClick="OpenCreateDialog">
            Create Your First API Key
        </MudButton>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var key in _apiKeys)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="apikey-card" Style="height: 100%;">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.Key" />
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@key.Name</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Size="Size.Small"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                             IconColor="Color.Error"
                                             OnClick="() => PromptRevoke(key.Id)">
                                    Revoke
                                </MudMenuItem>
                            </MudMenu>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        <div class="d-flex flex-column gap-1">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Created @key.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")
                                </MudText>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @if (key.LastUsedUtc.HasValue)
                                    {
                                        @($"Last used {key.LastUsedUtc.Value.ToLocalTime().ToString("MMM d, yyyy")}")
                                    }
                                    else
                                    {
                                        <span>Never used</span>
                                    }
                                </MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@* Create API Key Dialog *@
<MudDialog @bind-Visible="_dialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Style="vertical-align: middle;" />
            New API Key
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_formKeyName"
                      Label="Key Name"
                      Placeholder="e.g., Mobile App, CI/CD Pipeline"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      Immediate="true" />

        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_formError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="CreateKey"
                   Disabled="@_creating">
            @if (_creating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .apikey-card:hover {
        transform: translateY(-2px);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .apikey-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ApiKeyDto>? _apiKeys;
    private bool _loading = true;
    private bool _creating;
    private string? _error;
    private string? _formError;
    private string? _newlyCreatedKey;
    private string? _userId;

    private bool _dialogVisible;

    // Form fields
    private string _formKeyName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState!;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

            if (string.IsNullOrEmpty(_userId))
            {
                _error = "Unable to identify user.";
                return;
            }

            await RefreshKeys();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load API keys: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _formKeyName = "";
        _formError = null;
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
        _formKeyName = "";
        _formError = null;
    }

    private async Task CreateKey()
    {
        _formError = null;
        _newlyCreatedKey = null;

        if (string.IsNullOrWhiteSpace(_formKeyName))
        {
            _formError = "Key name is required.";
            return;
        }

        _creating = true;

        try
        {
            var result = await ApiKeyService.CreateKeyAsync(_userId!, _formKeyName.Trim());
            _newlyCreatedKey = result.PlainKey;

            await RefreshKeys();
            _dialogVisible = false;
            _formKeyName = "";
            Snackbar.Add("API key created.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to create API key: {ex.Message}";
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task PromptRevoke(int keyId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Revoke API Key",
            "Are you sure you want to revoke this API key? This action cannot be undone.",
            yesText: "Revoke", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ConfirmRevoke(keyId);
        }
    }

    private async Task ConfirmRevoke(int keyId)
    {
        try
        {
            await ApiKeyService.RevokeKeyAsync(keyId, _userId!);
            await RefreshKeys();
            Snackbar.Add("API key revoked.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to revoke API key: {ex.Message}";
        }
    }

    private async Task RefreshKeys()
    {
        _apiKeys = await ApiKeyService.GetUserKeysAsync(_userId!);
    }

    private async Task CopyKeyToClipboard()
    {
        if (_newlyCreatedKey is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newlyCreatedKey);
            Snackbar.Add("Key copied to clipboard!", Severity.Success);
        }
    }
}
