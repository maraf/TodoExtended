@page "/api-keys"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Services
@inject IApiKeyService ApiKeyService
@inject NavigationManager NavigationManager

<PageTitle>API Keys</PageTitle>

<Heading Tag="HeadingTag.H1" class="mb-6">API Keys</Heading>

@if (_loading)
{
    <div class="flex items-center gap-2">
        <Spinner Size="SpinnerSize.Sm" Color="SpinnerColor.Info" />
        <span class="text-gray-500 dark:text-gray-400">Loading API keys...</span>
    </div>
}
else if (_error is not null)
{
    <Alert Color="AlertColor.Failure">
        <CustomContent>@_error</CustomContent>
    </Alert>
}
else
{
    @if (_newlyCreatedKey is not null)
    {
        <Alert Color="AlertColor.Warning" class="mb-6">
            <CustomContent>
                <div class="flex items-start justify-between">
                    <div>
                        <h5 class="text-lg font-semibold mb-1">⚠️ Copy this key now! It will only be shown once.</h5>
                        <p class="mb-2 text-sm">Your new API key has been created. Make sure to copy it now — you won't be able to see it again!</p>
                        <div class="bg-gray-100 dark:bg-gray-700 p-3 rounded-lg border border-gray-200 dark:border-gray-600">
                            <code class="text-sm break-all">@_newlyCreatedKey</code>
                        </div>
                    </div>
                    <button class="ml-4 shrink-0 text-sm hover:opacity-75" @onclick="() => _newlyCreatedKey = null">✕</button>
                </div>
            </CustomContent>
        </Alert>
    }

    <Card class="mb-6">
        <Heading Tag="HeadingTag.H5" class="mb-4">Create New API Key</Heading>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-6">
                <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Key Name</label>
                <input type="text" @bind="_formKeyName" placeholder="e.g., Mobile App, CI/CD Pipeline"
                       class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" />
            </div>
            <div class="md:col-span-3">
                <Button Color="ButtonColor.Green" OnClick="CreateKey" Disabled="@_creating" Loading="@_creating">
                    Create
                </Button>
            </div>
        </div>

        @if (_formError is not null)
        {
            <Alert Color="AlertColor.Failure" class="mt-4">
                <CustomContent>@_formError</CustomContent>
            </Alert>
        }
    </Card>

    @if (_apiKeys is { Count: > 0 })
    {
        <Table Striped="true" Hoverable="true">
            <TableHead>
                <TableRow>
                    <TableHeadCell>Name</TableHeadCell>
                    <TableHeadCell>Created</TableHeadCell>
                    <TableHeadCell>Last Used</TableHeadCell>
                    <TableHeadCell><span class="sr-only">Actions</span></TableHeadCell>
                </TableRow>
            </TableHead>
            <TableBody class="divide-y">
                @foreach (var key in _apiKeys)
                {
                    <TableRow class="bg-white dark:border-gray-700 dark:bg-gray-800">
                        <TableCell>@key.Name</TableCell>
                        <TableCell>@key.CreatedUtc.ToLocalTime().ToString("g")</TableCell>
                        <TableCell>@(key.LastUsedUtc?.ToLocalTime().ToString("g") ?? "Never")</TableCell>
                        <TableCell>
                            <div class="flex gap-2">
                                @if (_revokeConfirmId == key.Id)
                                {
                                    <Button Size="ButtonSize.Small" Color="ButtonColor.Red" OnClick="() => ConfirmRevoke(key.Id)">Confirm</Button>
                                    <Button Size="ButtonSize.Small" Color="ButtonColor.Gray" OnClick="() => _revokeConfirmId = null">Cancel</Button>
                                }
                                else
                                {
                                    <Button Size="ButtonSize.Small" Color="ButtonColor.Red" OnClick="() => _revokeConfirmId = key.Id">Revoke</Button>
                                }
                            </div>
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
    else
    {
        <Paragraph class="text-gray-500 dark:text-gray-400">No API keys yet. Create one above!</Paragraph>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ApiKeyDto>? _apiKeys;
    private bool _loading = true;
    private bool _creating;
    private string? _error;
    private string? _formError;
    private int? _revokeConfirmId;
    private string? _newlyCreatedKey;
    private string? _userId;

    // Form fields
    private string _formKeyName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState!;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

            if (string.IsNullOrEmpty(_userId))
            {
                _error = "Unable to identify user.";
                return;
            }

            await RefreshKeys();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load API keys: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateKey()
    {
        _formError = null;
        _newlyCreatedKey = null;

        if (string.IsNullOrWhiteSpace(_formKeyName))
        {
            _formError = "Key name is required.";
            return;
        }

        _creating = true;

        try
        {
            var result = await ApiKeyService.CreateKeyAsync(_userId!, _formKeyName.Trim());
            _newlyCreatedKey = result.PlainKey;
            
            await RefreshKeys();
            _formKeyName = "";
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to create API key: {ex.Message}";
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task ConfirmRevoke(int keyId)
    {
        try
        {
            await ApiKeyService.RevokeKeyAsync(keyId, _userId!);
            await RefreshKeys();
            _revokeConfirmId = null;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to revoke API key: {ex.Message}";
        }
    }

    private async Task RefreshKeys()
    {
        _apiKeys = await ApiKeyService.GetUserKeysAsync(_userId!);
    }
}
