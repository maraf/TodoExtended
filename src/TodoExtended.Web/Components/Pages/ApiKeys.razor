@page "/api-keys"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Services
@inject IApiKeyService ApiKeyService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>API Keys</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">API Keys</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">Manage API keys for external integrations.</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    @if (_newlyCreatedKey is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-6" ShowCloseIcon="true" CloseIconClicked="() => _newlyCreatedKey = null">
            <MudText Typo="Typo.subtitle1" Class="mb-1"><strong>⚠️ Copy this key now!</strong> It will only be shown once.</MudText>
            <MudTextField Value="@_newlyCreatedKey" ReadOnly="true" Variant="Variant.Outlined"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                          OnAdornmentClick="CopyKeyToClipboard" Class="mt-2" />
        </MudAlert>
    }

    <MudPaper Elevation="2" Class="pa-4 mb-6">
        <MudText Typo="Typo.h6" Class="mb-4">Create New API Key</MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_formKeyName" Label="Key Name" Placeholder="e.g., Mobile App, CI/CD Pipeline" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateKey" Disabled="@_creating">
                    @if (_creating)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Create
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_formError</MudAlert>
        }
    </MudPaper>

    @if (_apiKeys is { Count: > 0 })
    {
        <MudDataGrid T="ApiKeyDto" Items="@_apiKeys" Striped="true" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <TemplateColumn Title="Created">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.CreatedUtc.ToLocalTime().ToString("g")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Last Used">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@(context.Item.LastUsedUtc?.ToLocalTime().ToString("g") ?? "Never")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => PromptRevoke(context.Item.Id)" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
    else
    {
        <MudAlert Severity="Severity.Info">No API keys yet. Create one above!</MudAlert>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ApiKeyDto>? _apiKeys;
    private bool _loading = true;
    private bool _creating;
    private string? _error;
    private string? _formError;
    private string? _newlyCreatedKey;
    private string? _userId;

    // Form fields
    private string _formKeyName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState!;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

            if (string.IsNullOrEmpty(_userId))
            {
                _error = "Unable to identify user.";
                return;
            }

            await RefreshKeys();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load API keys: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateKey()
    {
        _formError = null;
        _newlyCreatedKey = null;

        if (string.IsNullOrWhiteSpace(_formKeyName))
        {
            _formError = "Key name is required.";
            return;
        }

        _creating = true;

        try
        {
            var result = await ApiKeyService.CreateKeyAsync(_userId!, _formKeyName.Trim());
            _newlyCreatedKey = result.PlainKey;
            
            await RefreshKeys();
            _formKeyName = "";
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to create API key: {ex.Message}";
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task PromptRevoke(int keyId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Revoke API Key",
            "Are you sure you want to revoke this API key? This action cannot be undone.",
            yesText: "Revoke", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ConfirmRevoke(keyId);
        }
    }

    private async Task ConfirmRevoke(int keyId)
    {
        try
        {
            await ApiKeyService.RevokeKeyAsync(keyId, _userId!);
            await RefreshKeys();
            Snackbar.Add("API key revoked.", Severity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to revoke API key: {ex.Message}";
        }
    }

    private async Task RefreshKeys()
    {
        _apiKeys = await ApiKeyService.GetUserKeysAsync(_userId!);
    }

    private void CopyKeyToClipboard()
    {
        Snackbar.Add("Key copied to clipboard! (Use Ctrl+C to copy from the field)", Severity.Info);
    }
}
