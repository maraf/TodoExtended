@page "/api-keys"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Services
@inject IApiKeyService ApiKeyService
@inject NavigationManager NavigationManager
@inject INotificationService Notifications
@inject IJSRuntime JS

<PageTitle>API Keys</PageTitle>

<PageHeader Title="API Keys" FromColor="from-emerald-500" ToColor="to-teal-600" ShadowColor="shadow-emerald-500/20">
    <Icon>
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
    </Icon>
</PageHeader>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <p class="text-slate-500 dark:text-slate-400 text-sm">Manage keys for external integrations.</p>
    @if (!_loading && _error is null)
    {
        <button @onclick="OpenCreateDialog" class="btn-primary flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New API Key
        </button>
    }
</div>

@if (_newlyCreatedKey is not null)
{
    <div class="mb-6 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 p-5">
        <div class="flex items-start gap-3 mb-3">
            <span class="text-xl">🔑</span>
            <div>
                <p class="font-bold text-amber-800 dark:text-amber-300 text-sm">Copy this key now!</p>
                <p class="text-amber-700 dark:text-amber-400 text-xs mt-0.5">It will only be shown once.</p>
            </div>
            <button @onclick="() => _newlyCreatedKey = null" class="ml-auto p-1 text-amber-600 hover:text-amber-800 dark:hover:text-amber-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="flex gap-2">
            <input type="text" readonly value="@_newlyCreatedKey" class="input font-mono text-xs flex-1" />
            <button @onclick="CopyKeyToClipboard" class="btn-primary btn-sm flex-shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                Copy
            </button>
        </div>
    </div>
}

@if (_loading)
{
    <SkeletonGrid Height="h-36" />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_apiKeys is not { Count: > 0 })
{
    <EmptyState Emoji="🔐" Heading="No API keys yet" Description="Create keys to access your tasks from external tools."
               ActionLabel="Create First API Key" OnAction="OpenCreateDialog" Dashed="true">
        <ActionIcon>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
        </ActionIcon>
    </EmptyState>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var key in _apiKeys)
        {
            var k = key;
            <div class="card-hover dark:bg-slate-800 dark:border-slate-700 p-5">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-bold text-slate-900 dark:text-white text-sm truncate">@k.Name</p>
                    </div>
                    <button @onclick="() => PromptRevoke(k.Id)" class="p-1.5 text-rose-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-lg transition-colors" title="Revoke">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                    </button>
                </div>
                <div class="space-y-1.5 text-xs text-slate-500 dark:text-slate-400">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        Created @k.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")
                    </div>
                    <div class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        @(k.LastUsedUtc.HasValue ? $"Last used {k.LastUsedUtc.Value.ToLocalTime():MMM d, yyyy}" : "Never used")
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Create API Key Modal -->
<ModalDialog Visible="_dialogVisible" Title="New API Key" OnClose="CloseDialog">
    <Body>
        <FloatingField Label="Key Name" @bind-Value="_formKeyName" />
        @if (_formError is not null)
        {
            <div class="mt-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-4 py-3 text-sm">@_formError</div>
        }
    </Body>
    <Footer>
        <button @onclick="CloseDialog" class="btn-ghost">Cancel</button>
        <button @onclick="CreateKey" disabled="@_creating" class="btn-primary">
            @if (_creating)
            {
                <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
            }
            Create Key
        </button>
    </Footer>
</ModalDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ApiKeyDto>? _apiKeys;
    private bool _loading = true;
    private bool _creating;
    private string? _error;
    private string? _formError;
    private string? _newlyCreatedKey;
    private string? _userId;
    private bool _dialogVisible;
    private string _formKeyName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState!;
            _userId = authState.User.GetUserIdOrNull();

            if (string.IsNullOrEmpty(_userId))
            {
                NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
                return;
            }

            await RefreshKeys();
        }
        catch (Exception ex) when (AuthExceptionHelper.IsIrrecoverableMsalError(ex))
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
            return;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load API keys: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _formKeyName = "";
        _formError = null;
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
        _formKeyName = "";
        _formError = null;
    }

    private async Task CreateKey()
    {
        _formError = null;
        _newlyCreatedKey = null;

        if (string.IsNullOrWhiteSpace(_formKeyName))
        {
            _formError = "Key name is required.";
            return;
        }

        _creating = true;

        try
        {
            var result = await ApiKeyService.CreateKeyAsync(_userId!, _formKeyName.Trim());
            _newlyCreatedKey = result.PlainKey;

            await RefreshKeys();
            _dialogVisible = false;
            _formKeyName = "";
            Notifications.Add("API key created.", NotifySeverity.Success);
        }
        catch (Exception ex) when (AuthExceptionHelper.IsIrrecoverableMsalError(ex))
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
            return;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to create API key: {ex.Message}";
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task PromptRevoke(int keyId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to revoke this API key? This cannot be undone.");
        if (confirmed)
        {
            await ConfirmRevoke(keyId);
        }
    }

    private async Task ConfirmRevoke(int keyId)
    {
        try
        {
            await ApiKeyService.RevokeKeyAsync(keyId, _userId!);
            await RefreshKeys();
            Notifications.Add("API key revoked.", NotifySeverity.Success);
        }
        catch (Exception ex) when (AuthExceptionHelper.IsIrrecoverableMsalError(ex))
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
            return;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Notifications.Add($"Failed to revoke API key: {ex.Message}", NotifySeverity.Error);
        }
    }

    private async Task RefreshKeys()
    {
        _apiKeys = await ApiKeyService.GetUserKeysAsync(_userId!);
    }

    private async Task CopyKeyToClipboard()
    {
        if (_newlyCreatedKey is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newlyCreatedKey);
            Notifications.Add("Key copied to clipboard!", NotifySeverity.Success);
        }
    }
}

