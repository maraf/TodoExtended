@page "/api-keys"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Services
@inject IApiKeyService ApiKeyService
@inject NavigationManager NavigationManager

<PageTitle>API Keys</PageTitle>

<h1>API Keys</h1>

@if (_loading)
{
    <p><em>Loading API keys...</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    @if (_newlyCreatedKey is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <h5 class="alert-heading">⚠️ Copy this key now! It will only be shown once.</h5>
            <p class="mb-2">Your new API key has been created. Make sure to copy it now - you won't be able to see it again!</p>
            <div class="bg-light p-3 rounded border">
                <code style="font-size: 1.1em; word-break: break-all;">@_newlyCreatedKey</code>
            </div>
            <button type="button" class="btn-close" @onclick="() => _newlyCreatedKey = null" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Create New API Key</h5>

            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Key Name</label>
                    <input type="text" class="form-control" @bind="_formKeyName" placeholder="e.g., Mobile App, CI/CD Pipeline" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-success" @onclick="CreateKey" disabled="@_creating">
                        @if (_creating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Create
                    </button>
                </div>
            </div>

            @if (_formError is not null)
            {
                <div class="alert alert-danger mt-3">@_formError</div>
            }
        </div>
    </div>

    @if (_apiKeys is { Count: > 0 })
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Created</th>
                    <th>Last Used</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var key in _apiKeys)
                {
                    <tr>
                        <td>@key.Name</td>
                        <td>@key.CreatedUtc.ToLocalTime().ToString("g")</td>
                        <td>@(key.LastUsedUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                        <td>
                            @if (_revokeConfirmId == key.Id)
                            {
                                <button class="btn btn-sm btn-danger me-1" @onclick="() => ConfirmRevoke(key.Id)">Confirm</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => _revokeConfirmId = null">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _revokeConfirmId = key.Id">Revoke</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No API keys yet. Create one above!</p>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ApiKeyDto>? _apiKeys;
    private bool _loading = true;
    private bool _creating;
    private string? _error;
    private string? _formError;
    private int? _revokeConfirmId;
    private string? _newlyCreatedKey;
    private string? _userId;

    // Form fields
    private string _formKeyName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState!;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

            if (string.IsNullOrEmpty(_userId))
            {
                _error = "Unable to identify user.";
                return;
            }

            await RefreshKeys();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load API keys: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateKey()
    {
        _formError = null;
        _newlyCreatedKey = null;

        if (string.IsNullOrWhiteSpace(_formKeyName))
        {
            _formError = "Key name is required.";
            return;
        }

        _creating = true;

        try
        {
            var result = await ApiKeyService.CreateKeyAsync(_userId!, _formKeyName.Trim());
            _newlyCreatedKey = result.PlainKey;
            
            await RefreshKeys();
            _formKeyName = "";
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to create API key: {ex.Message}";
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task ConfirmRevoke(int keyId)
    {
        try
        {
            await ApiKeyService.RevokeKeyAsync(keyId, _userId!);
            await RefreshKeys();
            _revokeConfirmId = null;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to revoke API key: {ex.Message}";
        }
    }

    private async Task RefreshKeys()
    {
        _apiKeys = await ApiKeyService.GetUserKeysAsync(_userId!);
    }
}
