@page "/api-keys"
@attribute [Authorize]
@using Microsoft.Identity.Web
@using TodoExtended.Web.Data
@inject IApiKeyService ApiKeyService
@inject NavigationManager NavigationManager
@inject INotificationService Notifications
@inject IJSRuntime JS

<PageTitle>API Keys</PageTitle>

<!-- Page header -->
<div class="mb-8 flex items-center gap-4">
    <div class="w-14 h-14 rounded-3xl bg-gradient-to-br from-emerald-400 to-teal-500
                flex items-center justify-center
                shadow-2xl shadow-emerald-500/40
                flex-shrink-0 animate-float">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
    </div>
    <div class="flex-1">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">API Keys</h1>
        <p class="text-slate-400 dark:text-slate-500 text-sm mt-0.5">Manage keys for external integrations.</p>
    </div>
    @if (_userId is not null)
    {
        <button @onclick="OpenCreateDialog"
                class="btn bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white text-sm px-5 py-2.5 rounded-2xl shadow-lg shadow-emerald-500/25 hover:shadow-xl hover:-translate-y-0.5 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
            </svg>
            New Key
        </button>
    }
</div>

@if (_loading)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @for (int i = 0; i < 2; i++)
        {
            <div class="h-40 rounded-3xl animate-pulse"
                 style="background: linear-gradient(135deg, rgba(16,185,129,0.07) 0%, rgba(20,184,166,0.05) 100%); border: 1px solid rgba(255,255,255,0.7)">
            </div>
        }
    </div>
}
else if (_error is not null)
{
    <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-5 py-4 text-sm font-medium">⚠ @_error</div>
}
else if (_userId is null)
{
    <div class="float-card p-10 flex flex-col items-center text-center gap-3">
        <div class="text-4xl animate-float">🔐</div>
        <p class="text-slate-500 dark:text-slate-400 text-sm">⚠ Unable to identify user.</p>
    </div>
}
else
{
    <!-- Newly created key banner -->
    @if (_newlyCreatedKey is not null)
    {
        <div class="mb-5 float-card p-4 bg-emerald-50/80 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-700/50 flex items-start gap-3">
            <div class="w-9 h-9 rounded-2xl bg-emerald-500 flex items-center justify-center flex-shrink-0 shadow-md shadow-emerald-500/25">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-emerald-800 dark:text-emerald-300 mb-1">New key created — copy it now!</p>
                <code class="text-xs font-mono bg-white/80 dark:bg-emerald-950/50 px-3 py-1.5 rounded-xl border border-emerald-200 dark:border-emerald-700/50 text-emerald-700 dark:text-emerald-400 block truncate">@_newlyCreatedKey</code>
            </div>
            <button @onclick='() => JS.InvokeVoidAsync("navigator.clipboard.writeText", _newlyCreatedKey)'
                    class="p-2 rounded-xl text-emerald-600 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-colors flex-shrink-0" title="Copy">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
            </button>
        </div>
    }

    @if (_apiKeys.Count == 0)
    {
        <div class="float-card p-12 flex flex-col items-center text-center gap-4">
            <div class="w-16 h-16 rounded-3xl bg-gradient-to-br from-emerald-100 to-teal-100 dark:from-emerald-900/30 dark:to-teal-900/20
                        flex items-center justify-center shadow-lg shadow-emerald-500/10 text-3xl animate-float">
                🔑
            </div>
            <div>
                <h3 class="font-bold text-slate-700 dark:text-slate-300 mb-1">No API keys yet</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400">Create a key to integrate with Garmin and other apps.</p>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var key in _apiKeys)
            {
                var k = key;
                <div class="float-card p-5 flex flex-col gap-3 group relative overflow-hidden ">
                    <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-emerald-400/0 via-emerald-500/60 to-teal-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-full"></div>

                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-100 to-teal-100 dark:from-emerald-900/50 dark:to-teal-900/40
                                        flex items-center justify-center flex-shrink-0 shadow-sm
                                        group-hover:scale-110 transition-all duration-200">
                                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <p class="font-bold text-slate-900 dark:text-white text-sm">@k.Name</p>
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">
                                    Created @k.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")
                                </p>
                            </div>
                        </div>
                        <button @onclick="() => PromptRevoke(k.Id)"
                                    class="p-1.5 rounded-xl text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/30 transition-colors opacity-0 group-hover:opacity-100"
                                    title="Revoke">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                </svg>
                            </button>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <span class="chip chip-success">Active</span>
                        @if (k.LastUsedUtc.HasValue)
                        {
                            <span class="chip bg-slate-100 dark:bg-slate-700/60 text-slate-500 dark:text-slate-400">
                                Last used @k.LastUsedUtc.Value.ToLocalTime().ToString("MMM d")
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

<!-- ░░ CREATE KEY MODAL ░░ -->
@if (_dialogVisible)
{
    <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="key-dialog-title">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" @onclick="CloseDialog"></div>
        <div class="relative z-10 w-full max-w-md animate-slide-up
                    bg-white/90 dark:bg-slate-900/90 backdrop-blur-2xl
                    rounded-3xl border border-white/80 dark:border-white/10
                    shadow-2xl shadow-slate-900/30 p-6 sm:p-7">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/30">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                    </div>
                    <h2 id="key-dialog-title" class="text-lg font-extrabold text-slate-900 dark:text-white">New API Key</h2>
                </div>
                <button @onclick="CloseDialog" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="label">Key Name</label>
                    <input @bind="_formKeyName" type="text" class="input" placeholder="e.g. Garmin Watch" />
                </div>
                @if (_formError is not null)
                {
                    <p class="text-sm text-rose-600 dark:text-rose-400 font-medium">⚠ @_formError</p>
                }
            </div>
            <div class="flex gap-3 mt-7">
                <button @onclick="CloseDialog" class="btn-ghost flex-1 py-2.5 rounded-2xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300">Cancel</button>
                <button @onclick="CreateKey" disabled="@_creating"
                        class="btn bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white flex-1 py-2.5 rounded-2xl shadow-lg shadow-emerald-500/25 disabled:opacity-50">
                    @if (_creating) { <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> }
                    <span>@(_creating ? "Creating…" : "Create")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<ApiKeyDto>? _apiKeys;
    private bool _loading = true;
    private bool _creating;
    private string? _error;
    private string? _formError;
    private string? _newlyCreatedKey;
    private string? _userId;
    private bool _dialogVisible;
    private string _formKeyName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState!;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

            if (string.IsNullOrEmpty(_userId))
            {
                _error = "Unable to identify user.";
                return;
            }

            await RefreshKeys();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load API keys: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _formKeyName = "";
        _formError = null;
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
        _formKeyName = "";
        _formError = null;
    }

    private async Task CreateKey()
    {
        _formError = null;
        _newlyCreatedKey = null;

        if (string.IsNullOrWhiteSpace(_formKeyName))
        {
            _formError = "Key name is required.";
            return;
        }

        _creating = true;

        try
        {
            var result = await ApiKeyService.CreateKeyAsync(_userId!, _formKeyName.Trim());
            _newlyCreatedKey = result.PlainKey;

            await RefreshKeys();
            _dialogVisible = false;
            _formKeyName = "";
            Notifications.Add("API key created.", NotifySeverity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _formError = $"Failed to create API key: {ex.Message}";
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task PromptRevoke(int keyId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to revoke this API key? This cannot be undone.");
        if (confirmed)
        {
            await ConfirmRevoke(keyId);
        }
    }

    private async Task ConfirmRevoke(int keyId)
    {
        try
        {
            await ApiKeyService.RevokeKeyAsync(keyId, _userId!);
            await RefreshKeys();
            Notifications.Add("API key revoked.", NotifySeverity.Success);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Notifications.Add($"Failed to revoke API key: {ex.Message}", NotifySeverity.Error);
        }
    }

    private async Task RefreshKeys()
    {
        _apiKeys = await ApiKeyService.GetUserKeysAsync(_userId!);
    }

    private async Task CopyKeyToClipboard()
    {
        if (_newlyCreatedKey is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newlyCreatedKey);
            Notifications.Add("Key copied to clipboard!", NotifySeverity.Success);
        }
    }
}

