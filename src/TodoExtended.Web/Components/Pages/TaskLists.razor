@page "/task-lists"
@attribute [Authorize]
@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<TaskLists> Logger

<PageTitle>Task Lists</PageTitle>

<SectionContent SectionName="page-header">
    <div class="flex items-center gap-3">
        <div class="hidden sm:flex w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 items-center justify-center shadow-lg shadow-emerald-500/20 flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
        </div>
        <h1 class="text-lg font-bold text-white tracking-tight">Task Lists</h1>
    </div>
</SectionContent>

@if (_error is not null)
{
    <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-400 px-5 py-4 text-sm font-medium">⚠ @_error</div>
}
else if (_loading)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="card dark:bg-slate-800 dark:border-slate-700 flex items-center gap-3 py-5 animate-pulse">
                <div class="w-9 h-9 rounded-xl bg-slate-200 dark:bg-slate-700 flex-shrink-0"></div>
                <div class="flex-1 h-4 bg-slate-100 dark:bg-slate-700 rounded-full"></div>
            </div>
        }
    </div>
}
else if (SyncedLists is not { Count: > 0 })
{
    <div class="flex flex-col items-center justify-center min-h-[40vh] text-center">
        <div class="text-6xl mb-5">📋</div>
        <h2 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">No synced lists</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">Configure which lists to sync in Sync Settings.</p>
        <a href="/sync-settings"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Sync Settings
        </a>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var list in SyncedLists!)
        {
            var (emoji, name) = list.Emoji();
            <a href="@($"/tasks/{list.Id}")"
               class="card dark:bg-slate-800 dark:border-slate-700 flex items-center gap-3 py-5 hover:border-brand-300 dark:hover:border-brand-600 hover:shadow-md hover:shadow-brand-500/10 transition-all duration-200 group no-underline">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center flex-shrink-0 group-hover:bg-brand-50 dark:group-hover:bg-brand-900/30 transition-colors">
                    @if (!string.IsNullOrEmpty(emoji))
                    {
                        <span class="text-lg leading-none">@emoji</span>
                    }
                    else
                    {
                        <svg class="w-5 h-5 text-slate-400 dark:text-slate-500 group-hover:text-brand-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                        </svg>
                    }
                </div>
                <span class="flex-1 min-w-0 text-sm font-medium text-slate-800 dark:text-slate-200 group-hover:text-brand-700 dark:group-hover:text-brand-300 truncate transition-colors">@name</span>
                <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 group-hover:text-brand-400 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        }
    </div>
}

@code {
    [PersistentState]
    public IReadOnlyList<PersistedTodoTaskList>? SyncedLists { get; set; }

    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (SyncedLists is not null)
        {
            Logger.LogDebug("OnInitializedAsync: SyncedLists restored from persistent state, count={Count}", SyncedLists.Count);
            _loading = false;
            return;
        }

        try
        {
            Logger.LogDebug("OnInitializedAsync: SyncedLists not in persistent state, fetching fresh");
            SyncedLists = (await TodoService.GetTaskListsAsync())
                .Select(l => new PersistedTodoTaskList(l.Id, l.DisplayName))
                .ToList();
            Logger.LogDebug("OnInitializedAsync: Fetched {Count} task lists", SyncedLists?.Count ?? 0);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load task lists: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
