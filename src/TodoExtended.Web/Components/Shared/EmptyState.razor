<div class="card dark:bg-slate-800 dark:border-slate-700 flex flex-col items-center justify-center py-20 text-center @(Dashed ? "border-2 border-dashed" : "")">
    @if (CustomIcon is not null)
    {
        @CustomIcon
    }
    else
    {
        <div class="text-5xl mb-4">@Emoji</div>
    }
    <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-2">@Heading</h3>
    <p class="text-slate-500 dark:text-slate-400 text-sm @(OnAction.HasDelegate ? "mb-6" : "")">@Description</p>
    @if (OnAction.HasDelegate && ActionLabel is not null)
    {
        <button @onclick="OnAction" class="btn-primary">
            @if (ActionIcon is not null)
            {
                @ActionIcon
            }
            @ActionLabel
        </button>
    }
</div>

@code {
    [Parameter] public string Emoji { get; set; } = "";
    [Parameter] public RenderFragment? CustomIcon { get; set; }
    [Parameter, EditorRequired] public string Heading { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public RenderFragment? ActionIcon { get; set; }
    [Parameter] public bool Dashed { get; set; }
}
