@using Microsoft.Identity.Web

@if (_isToggling)
{
    <div class="w-5 h-5 mr-3 flex-shrink-0 flex items-center justify-center">
        <svg class="animate-spin w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
    </div>
}
else
{
    <input type="checkbox"
           checked="@IsCompleted"
           @onchange="OnCheckChanged"
           aria-label="@(IsCompleted ? $"Mark \"{TaskTitle}\" incomplete" : $"Mark \"{TaskTitle}\" complete")"
           class="w-5 h-5 mr-3 flex-shrink-0 rounded-md border-2 border-slate-300 text-brand-600 cursor-pointer accent-brand-600 focus:ring-brand-500 focus:ring-offset-0 transition-colors" />
}

@code {
    [Parameter, EditorRequired] public string TaskId { get; set; } = default!;
    [Parameter, EditorRequired] public string ListId { get; set; } = default!;
    [Parameter, EditorRequired] public bool IsCompleted { get; set; }
    [Parameter, EditorRequired] public string TaskTitle { get; set; } = default!;
    [Parameter] public EventCallback<bool> OnStatusChanged { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Inject] private ITodoService TodoService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private bool _isToggling;

    private async Task OnCheckChanged(ChangeEventArgs e)
    {
        await Toggle();
    }

    private async Task Toggle()
    {
        if (_isToggling) return;

        _isToggling = true;
        var newStatus = !IsCompleted;

        await OnStatusChanged.InvokeAsync(newStatus);

        try
        {
            var state = await AuthState!;
            var userId = state.User.GetUserId();

            await TodoService.UpdateTaskStatusAsync(ListId, TaskId, newStatus, userId);
        }
        catch (Exception ex) when (AuthExceptionHelper.IsIrrecoverableMsalError(ex))
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
            return;
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
            return;
        }
        catch (Exception)
        {
            await OnStatusChanged.InvokeAsync(!newStatus);
            await OnError.InvokeAsync($"Failed to update \"{TaskTitle}\". Please try again.");
        }
        finally
        {
            _isToggling = false;
        }
    }
}
