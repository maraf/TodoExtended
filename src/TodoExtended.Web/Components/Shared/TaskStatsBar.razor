@if (OpenCount + CompletedCount > 0)
{
    <div class="flex items-center gap-2 mb-6">
        <span class="chip chip-primary">@OpenCount @OpenLabel</span>
        @if (CompletedCount > 0)
        {
            <span class="chip chip-success">@CompletedCount done</span>
        }
        @if (RescheduleModeChanged.HasDelegate)
        {
            <button @onclick="ToggleRescheduleMode"
                    class="text-xs flex items-center gap-1 transition-colors @(RescheduleMode ? "text-brand-600 dark:text-brand-400 font-medium" : "text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>Reschedule</span>
            </button>
        }
        <button @onclick="ToggleHideCompleted"
                class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 flex items-center gap-1 transition-colors ml-auto">
            @if (HideCompleted)
            {
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                </svg>
                <span>Show completed</span>
            }
            else
            {
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                <span>Hide completed</span>
            }
        </button>
    </div>
}

@code {
    [Parameter]
    public int OpenCount { get; set; }

    [Parameter]
    public int CompletedCount { get; set; }

    [Parameter]
    public string OpenLabel { get; set; } = "open";

    [Parameter]
    public bool HideCompleted { get; set; }

    [Parameter]
    public EventCallback<bool> HideCompletedChanged { get; set; }

    [Parameter]
    public bool RescheduleMode { get; set; }

    [Parameter]
    public EventCallback<bool> RescheduleModeChanged { get; set; }

    private async Task ToggleHideCompleted()
    {
        await HideCompletedChanged.InvokeAsync(!HideCompleted);
    }

    private async Task ToggleRescheduleMode()
    {
        await RescheduleModeChanged.InvokeAsync(!RescheduleMode);
    }
}
