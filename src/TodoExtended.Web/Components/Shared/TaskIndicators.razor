@* Renders reminder and recurring indicator icons for a task row. *@

@if (HasReminder)
{
    <svg class="w-4 h-4 text-sky-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
         role="img" aria-label="Has reminder">
        <title>Has reminder</title>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
    </svg>
}
@if (IsRecurring)
{
    <svg class="w-4 h-4 text-violet-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
         role="img" aria-label="Recurring">
        <title>Recurring</title>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
    </svg>
}

@code {
    /// <summary>When true, renders the reminder bell icon.</summary>
    [Parameter] public bool HasReminder { get; set; }

    /// <summary>When true, renders the recurring arrows icon.</summary>
    [Parameter] public bool IsRecurring { get; set; }
}
