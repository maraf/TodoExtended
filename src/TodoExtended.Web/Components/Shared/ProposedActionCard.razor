@* ProposedActionCard.razor — Action confirmation card for AI-proposed task actions *@

@{
    var taskTitle = Action.Parameters.GetValueOrDefault("title")
                    ?? Action.Parameters.GetValueOrDefault("taskTitle");
    var listId = Action.Parameters.GetValueOrDefault("listId");
    var listName = Action.Parameters.GetValueOrDefault("listName");
    var templateId = Action.Parameters.GetValueOrDefault("templateId");
}

<div class="rounded-xl border @AccentBorderClass() bg-white dark:bg-slate-800 p-3 shadow-sm">
    <div class="flex items-start gap-3">
        <div class="flex-shrink-0 w-8 h-8 rounded-lg @AccentBgClass() flex items-center justify-center">
            @ActionIcon()
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
                <span class="chip @AccentChipClass()">@ActionLabel()</span>
            </div>
            @if (taskTitle is not null)
            {
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300 break-words">@taskTitle</p>
            }
            else
            {
                <p class="text-sm text-slate-700 dark:text-slate-300">@Action.Description</p>
            }
            @if (listId is not null)
            {
                <a href="/tasks/@listId" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">
                    @(listName ?? "Task list")
                </a>
            }
        </div>
    </div>

    @if (Result is not null)
    {
        <div class="mt-2 flex items-center gap-2 text-xs font-medium @(Result.Success ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
            @if (Result.Success)
            {
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            }
            else
            {
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            }
            <span>@Result.Message</span>
        </div>
    }
    else if (_decided)
    {
        <div class="mt-2 flex items-center gap-2 text-xs font-medium @(_approved ? "text-emerald-600 dark:text-emerald-400" : "text-slate-400 dark:text-slate-500")">
            @if (_approved)
            {
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Approved</span>
            }
            else
            {
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
                <span>Rejected</span>
            }
        </div>
    }
    else if (!IsRestored)
    {
        <div class="mt-2 flex items-center gap-2">
            <button @onclick="() => Decide(true)"
                    class="btn btn-sm bg-emerald-600 hover:bg-emerald-700 text-white focus:ring-emerald-500 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Approve
            </button>
            <button @onclick="() => Decide(false)"
                    class="btn btn-sm bg-rose-600 hover:bg-rose-700 text-white focus:ring-rose-500 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Reject
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ProposedAction Action { get; set; } = default!;
    [Parameter] public int ActionIndex { get; set; }
    [Parameter] public EventCallback<ActionConfirmation> OnConfirmation { get; set; }
    [Parameter] public ActionResult? Result { get; set; }
    [Parameter] public bool IsRestored { get; set; }

    private bool _decided;
    private bool _approved;

    private async Task Decide(bool approved)
    {
        _decided = true;
        _approved = approved;
        await OnConfirmation.InvokeAsync(new ActionConfirmation(ActionIndex, approved));
    }

    private string ActionLabel() => Action.Type switch
    {
        TaskActionType.CreateTask => "Create",
        TaskActionType.CompleteTask => "Complete",
        TaskActionType.UncompleteTask => "Reopen",
        TaskActionType.CreateTemplate => "Create Template",
        TaskActionType.UpdateTemplate => "Update Template",
        TaskActionType.DeleteTemplate => "Delete Template",
        TaskActionType.ExecuteTemplate => "Execute Template",
        _ => "Action"
    };

    private string AccentBorderClass() => Action.Type switch
    {
        TaskActionType.CreateTask => "border-emerald-200 dark:border-emerald-800",
        TaskActionType.CompleteTask => "border-brand-200 dark:border-brand-800",
        TaskActionType.UncompleteTask => "border-amber-200 dark:border-amber-800",
        TaskActionType.CreateTemplate => "border-violet-200 dark:border-violet-800",
        TaskActionType.UpdateTemplate => "border-violet-200 dark:border-violet-800",
        TaskActionType.DeleteTemplate => "border-rose-200 dark:border-rose-800",
        TaskActionType.ExecuteTemplate => "border-cyan-200 dark:border-cyan-800",
        _ => "border-slate-200 dark:border-slate-700"
    };

    private string AccentBgClass() => Action.Type switch
    {
        TaskActionType.CreateTask => "bg-emerald-100 dark:bg-emerald-900/40",
        TaskActionType.CompleteTask => "bg-brand-100 dark:bg-brand-900/40",
        TaskActionType.UncompleteTask => "bg-amber-100 dark:bg-amber-900/40",
        TaskActionType.CreateTemplate => "bg-violet-100 dark:bg-violet-900/40",
        TaskActionType.UpdateTemplate => "bg-violet-100 dark:bg-violet-900/40",
        TaskActionType.DeleteTemplate => "bg-rose-100 dark:bg-rose-900/40",
        TaskActionType.ExecuteTemplate => "bg-cyan-100 dark:bg-cyan-900/40",
        _ => "bg-slate-100 dark:bg-slate-700"
    };

    private string AccentChipClass() => Action.Type switch
    {
        TaskActionType.CreateTask => "chip-success",
        TaskActionType.CompleteTask => "chip-primary",
        TaskActionType.UncompleteTask => "chip-warning",
        TaskActionType.CreateTemplate => "chip-info",
        TaskActionType.UpdateTemplate => "chip-info",
        TaskActionType.DeleteTemplate => "chip-error",
        TaskActionType.ExecuteTemplate => "chip-success",
        _ => "chip-info"
    };

    private RenderFragment ActionIcon() => Action.Type switch
    {
        TaskActionType.CreateTask => @<svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>,
        TaskActionType.CompleteTask => @<svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>,
        TaskActionType.UncompleteTask => @<svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" /></svg>,
        TaskActionType.CreateTemplate => @<svg class="w-4 h-4 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 3v6h6" /></svg>,
        TaskActionType.UpdateTemplate => @<svg class="w-4 h-4 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>,
        TaskActionType.DeleteTemplate => @<svg class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>,
        TaskActionType.ExecuteTemplate => @<svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>,
        _ => @<svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5" stroke-width="2" /></svg>,
    };
}
