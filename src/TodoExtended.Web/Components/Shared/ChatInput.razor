@* ChatInput.razor — Chat text input with image upload and send button *@
@using Microsoft.AspNetCore.Components.Forms
@using TodoExtended.Web.Services.AiChat

<div class="space-y-2">
    @* Image preview strip *@
    @if (_images.Count > 0)
    {
        <div class="flex flex-wrap gap-2 px-1">
            @for (var i = 0; i < _images.Count; i++)
            {
                var idx = i;
                <div class="relative group">
                    <img src="@_images[idx]"
                         alt="Attached image @(idx + 1)"
                         class="h-16 w-16 object-cover rounded-xl border border-slate-200 dark:border-slate-600" />
                    <button @onclick="() => RemoveImage(idx)"
                            class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-slate-700 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                            aria-label="Remove image">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    }

    <div class="flex items-end gap-2">
        @* Hidden file input *@
        <InputFile @ref="_fileInput" OnChange="HandleFileSelected" multiple accept="image/*"
                   class="hidden" id="chat-image-upload" />

        @* Image attach button *@
        <label for="chat-image-upload"
               class="@(_canAttachMore ? "cursor-pointer" : "cursor-not-allowed opacity-40") btn-ghost !rounded-2xl !px-3 h-[44px] flex-shrink-0 flex items-center justify-center"
               title="@(_canAttachMore ? "Attach image" : "Maximum 4 images")"
               aria-label="Attach image">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </label>

        <div class="flex-1 relative">
            <textarea @ref="_inputRef"
                      @bind="_text"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="Ask about your tasks…"
                      disabled="@IsDisabled"
                      rows="1"
                      class="input block resize-none min-h-[44px] max-h-32 pr-3 !rounded-2xl" />
        </div>
        <button @onclick="Send"
                disabled="@(IsDisabled || (string.IsNullOrWhiteSpace(_text) && _images.Count == 0))"
                class="btn-primary !rounded-2xl !px-4 h-[44px] flex-shrink-0"
                aria-label="Send message">
            @if (IsDisabled)
            {
                <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
            }
            else
            {
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
            }
        </button>
    </div>
</div>

@code {
    private const int MaxImages = 4;
    private const long MaxImageBytes = 5 * 1024 * 1024; // 5 MB

    [Parameter] public EventCallback<ChatInputPayload> OnSend { get; set; }
    [Parameter] public bool IsDisabled { get; set; }

    private ElementReference _inputRef;
    private InputFile? _fileInput;
    private string _text = "";
    private readonly List<string> _images = new();

    private bool _canAttachMore => _images.Count < MaxImages;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _inputRef.FocusAsync();
        }
    }

    public async Task FocusAsync() => await _inputRef.FocusAsync();

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(MaxImages))
        {
            if (_images.Count >= MaxImages) break;
            if (file.Size > MaxImageBytes) continue;

            using var ms = new MemoryStream();
            await using var stream = file.OpenReadStream(MaxImageBytes);
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            _images.Add($"data:{file.ContentType};base64,{base64}");
        }
        StateHasChanged();
    }

    private void RemoveImage(int index)
    {
        if (index >= 0 && index < _images.Count)
            _images.RemoveAt(index);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Send();
        }
    }

    private async Task Send()
    {
        var message = _text.Trim();
        if ((string.IsNullOrWhiteSpace(message) && _images.Count == 0) || IsDisabled) return;

        var images = _images.ToList();
        _text = "";
        _images.Clear();
        await OnSend.InvokeAsync(new ChatInputPayload(message, images));
    }
}
