@if (Visible)
{
    <div class="w-full flex flex-wrap gap-2 pt-2 pb-1 pl-9 sm:gap-1 sm:pt-1 sm:pb-0.5">
        @foreach (var opt in DateOptions)
        {
            var capturedOpt = opt;
            <button @onclick="() => OnDateSelected.InvokeAsync(capturedOpt.Date)"
                    disabled="@IsDisabled"
                    class="text-sm px-3 py-2 rounded-full border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-brand-50 hover:border-brand-400 hover:text-brand-700 dark:hover:bg-brand-900/30 dark:hover:border-brand-500 dark:hover:text-brand-300 transition-colors disabled:opacity-50 sm:text-xs sm:px-2 sm:py-0.5">
                @if (IsMoving)
                {
                    <span>...</span>
                }
                else
                {
                    @capturedOpt.Label
                }
            </button>
        }
    </div>
}

@code {
    /// <summary>Whether to render the picker (typically <c>rescheduleMode &amp;&amp; !task.IsCompleted</c>).</summary>
    [Parameter, EditorRequired] public bool Visible { get; set; }

    /// <summary>Whether THIS specific task's move is in progress (shows "..." on its buttons).</summary>
    [Parameter, EditorRequired] public bool IsMoving { get; set; }

    /// <summary>Whether any move is in progress (disables all buttons, including on other tasks).</summary>
    [Parameter, EditorRequired] public bool IsDisabled { get; set; }

    /// <summary>Available target dates.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Label, DateOnly Date)> DateOptions { get; set; } = [];

    /// <summary>Raised when the user selects a target date.</summary>
    [Parameter, EditorRequired] public EventCallback<DateOnly> OnDateSelected { get; set; }
}
