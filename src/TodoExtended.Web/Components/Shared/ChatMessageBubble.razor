@* ChatMessageBubble.razor — Single chat message with optional proposed actions *@

@{ var isUser = Message.Role == "user"; }

<div class="flex @(isUser ? "justify-end" : "justify-start") animate-fade-in">
    <div class="max-w-[85%] sm:max-w-[75%]">
        @if (Message.Text is not null)
        {
            <div class="@BubbleClasses(isUser) rounded-2xl px-4 py-2.5 text-sm leading-relaxed @(isUser ? "rounded-br-md" : "rounded-bl-md")">
                <span class="whitespace-pre-wrap break-words">@Message.Text</span>
                @if (!isUser && Message.TaskListReferences is { Count: > 0 })
                {
                    <div class="mt-2 pt-2 border-t border-slate-200 dark:border-slate-600 flex flex-wrap gap-x-3 gap-y-1">
                        @foreach (var list in Message.TaskListReferences)
                        {
                            <a href="/tasks/@list.Id"
                               class="inline-flex items-center gap-1 text-xs font-medium text-brand-600 dark:text-brand-400 hover:underline">
                                <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                                @list.DisplayName
                            </a>
                        }
                    </div>
                }
            </div>
        }

        @if (Message.ProposedActions is { Count: > 0 })
        {
            <div class="mt-2 space-y-2">
                @for (var i = 0; i < Message.ProposedActions.Count; i++)
                {
                    var index = i;
                    var action = Message.ProposedActions[index];
                    <ProposedActionCard Action="@action"
                                        ActionIndex="@index"
                                        OnConfirmation="OnActionConfirmation"
                                        Result="@GetResult(index)"
                                        IsRestored="@IsRestored" />
                }
            </div>
        }

        <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-1 @(isUser ? "text-right" : "text-left") px-1">
            @Message.Timestamp.ToLocalTime().ToString("h:mm tt")
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public EventCallback<ActionConfirmation> OnActionConfirmation { get; set; }
    [Parameter] public IReadOnlyList<ActionResult>? ActionResults { get; set; }
    [Parameter] public bool IsRestored { get; set; }

    private ActionResult? GetResult(int index) =>
        ActionResults?.FirstOrDefault(r => r.ActionIndex == index);

    private static string BubbleClasses(bool isUser) => isUser
        ? "bg-brand-600 dark:bg-brand-700 text-white"
        : "bg-slate-100 dark:bg-slate-700 text-slate-800 dark:text-slate-200";
}
