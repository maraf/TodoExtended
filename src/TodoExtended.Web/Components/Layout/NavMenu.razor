    <SidebarItemGroup>
        <SidebarItem Href="/" Icon="@(new HomeIcon())">Home</SidebarItem>
        <AuthorizeView>
            <Authorized>
                <SidebarItem Href="/today" Icon="@(new CalendarMonthIcon())">Today</SidebarItem>
                <SidebarItem Href="/tasks" Icon="@(new ListIcon())">My Tasks</SidebarItem>
