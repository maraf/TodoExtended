@using Microsoft.Identity.Web
@using Microsoft.Extensions.Logging
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<NavMenu> Logger

<div class="nav-sidebar">
    <MudNavMenu Class="nav-menu-inner">
        <AuthorizeView>
            <Authorized>
                <div class="nav-section-label">MAIN</div>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Class="nav-link-item">Dashboard</MudNavLink>
                <MudNavLink Href="/today" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Today" Class="nav-link-item">Today</MudNavLink>
                <div class="nav-section-label mt-3">TOOLS</div>
                <MudNavLink Href="/templates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContentCopy" Class="nav-link-item">Templates</MudNavLink>
                <MudNavLink Href="/api-keys" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VpnKey" Class="nav-link-item">API Keys</MudNavLink>
                @if (_taskLists.Count > 0)
                {
                    <div class="nav-section-label mt-3">MY LISTS</div>
                    @foreach (var list in _taskLists)
                    {
                        var (emoji, name) = list.Emoji();
                        var icon = emoji == null ? Icons.Material.Filled.List : null;
                        <MudNavLink Href="@($"/tasks/{list.Id}")" Match="NavLinkMatch.Prefix" Icon="@icon" Class="nav-link-item">
                            @if (emoji != null)
                            {
                                <span class="nav-emoji-icon" style="margin-left: -12px; margin-right: 12px; font-size: 1.1em;">@emoji</span>
                            }
                            @name
                        </MudNavLink>
                    }
                }
                <div class="nav-section-label mt-3">SETTINGS</div>
                <MudNavLink Href="/sync-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SyncAlt" Class="nav-link-item">Sync Settings</MudNavLink>
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>
</div>

@code {
    [PersistentState]
    public IReadOnlyList<TodoTaskList>? TaskLists { get; set; }

    private IReadOnlyList<TodoTaskList> _taskLists => TaskLists ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (TaskLists is not null)
        {
            Logger.LogDebug("OnInitializedAsync: TaskLists restored from persistent state, count={Count}", TaskLists.Count);
            return;
        }

        try
        {
            TaskLists = await TodoService.GetTaskListsAsync();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
        }
        catch (Exception ex)
        {
            // Nav menu loads best-effort; a failure here should not break the layout.
            // Errors surface on the individual task pages when the user navigates there.
            Logger.LogWarning(ex, "NavMenu: failed to load task lists");
        }
    }
}
