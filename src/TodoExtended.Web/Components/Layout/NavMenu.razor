@using Microsoft.Identity.Web
@using Microsoft.Extensions.Logging
@inject ITodoService TodoService
@inject ITagService TagService
@inject NavigationManager NavigationManager
@inject ILogger<NavMenu> Logger

<nav class="py-4 flex flex-col h-full">
    <AuthorizeView>
        <Authorized>
            <p class="section-title mt-2">MAIN</p>
            <NavItem Href="/" Match="NavLinkMatch.All" Icon="grid">Home</NavItem>
            <NavItem Href="/today" Match="NavLinkMatch.Prefix" Icon="sun">Today</NavItem>
            <NavItem Href="/tomorrow" Match="NavLinkMatch.Prefix" Icon="calendar">Tomorrow</NavItem>
            <NavItem Href="/chat" Match="NavLinkMatch.Prefix" Icon="chat">AI Chat</NavItem>

            @if (_pinnedTags.Count > 0)
            {
                <p class="section-title mt-5">PINNED TAGS</p>
                @foreach (var tag in _pinnedTags)
                {
                    <NavItem Href="@($"/tags/{tag}")" Icon="tag">#@tag</NavItem>
                }
            }

            <p class="section-title mt-5">TOOLS</p>
            <NavItem Href="/templates" Match="NavLinkMatch.Prefix" Icon="copy">Templates</NavItem>
            <NavItem Href="/api-keys" Match="NavLinkMatch.Prefix" Icon="key">API Keys</NavItem>
            <NavItem Href="/tags" Match="NavLinkMatch.All" Icon="tag">Tags</NavItem>

            @if (_taskLists.Count > 0)
            {
                <p class="section-title mt-5">MY LISTS</p>
                @foreach (var list in _taskLists)
                {
                    var (emoji, name) = list.Emoji();
                    <NavListItem Href="@($"/tasks/{list.Id}")" Emoji="@emoji">@name</NavListItem>
                }
            }

        </Authorized>
    </AuthorizeView>
</nav>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [PersistentState]
    public IReadOnlyList<PersistedTodoTaskList>? TaskLists { get; set; }

    [PersistentState]
    public IReadOnlyList<string>? PinnedTags { get; set; }

    private IReadOnlyList<PersistedTodoTaskList> _taskLists => TaskLists ?? [];
    private IReadOnlyList<string> _pinnedTags => PinnedTags ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (TaskLists is not null && PinnedTags is not null)
        {
            Logger.LogDebug("OnInitializedAsync: state restored from persistent state (Lists: {ListCount}, PinnedTags: {TagCount})", TaskLists.Count, PinnedTags.Count);
            return;
        }

        try
        {
            if (AuthState is null) return;
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated != true) return;

            var userId = state.User.GetUserIdOrNull();
            if (string.IsNullOrEmpty(userId)) return;

            var listsTask = TodoService.GetTaskListsAsync(userId);
            var pinnedTask = TagService.GetPinnedTagsAsync(userId);

            await Task.WhenAll(listsTask, pinnedTask);

            TaskLists = (await listsTask)
                .Select(l => new PersistedTodoTaskList(l.Id, l.DisplayName))
                .ToList();

            PinnedTags = (await pinnedTask).ToList();
        }
        catch (Exception ex) when (AuthExceptionHelper.IsIrrecoverableMsalError(ex))
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException || AuthExceptionHelper.IsConsentRequired(ex))
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "NavMenu: failed to load task lists or pinned tags");
        }
    }
}
