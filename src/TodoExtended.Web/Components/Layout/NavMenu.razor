@using Microsoft.Identity.Web
@using Microsoft.Extensions.Logging
@inject ITodoService TodoService
@inject NavigationManager NavigationManager
@inject ILogger<NavMenu> Logger

<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/today" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Today">Today</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/templates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContentCopy">Templates</MudNavLink>
            <MudNavLink Href="/api-keys" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VpnKey">API Keys</MudNavLink>
            <MudDivider Class="my-2" />
            @foreach (var list in _taskLists)
            {
                var (emoji, name) = list.Emoji();
                var icon = emoji == null ? Icons.Material.Filled.List : null;
                <MudNavLink Href="@($"/tasks/{list.Id}")" Match="NavLinkMatch.Prefix" Icon="@icon">
                    @if (emoji != null)
                    {
                        <span class="nav-emoji-icon" style="margin-left: -12px;margin-right: 12px;">@emoji</span>
                    }
                    @name
                </MudNavLink>
            }
            <MudNavLink Href="/sync-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SyncAlt">Sync Settings</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [PersistentState]
    public IReadOnlyList<TodoTaskList>? TaskLists { get; set; }

    private IReadOnlyList<TodoTaskList> _taskLists => TaskLists ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (TaskLists is not null)
        {
            Logger.LogDebug("OnInitializedAsync: TaskLists restored from persistent state, count={Count}", TaskLists.Count);
            return;
        }

        try
        {
            TaskLists = await TodoService.GetTaskListsAsync();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
        }
        catch (Exception ex)
        {
            // Nav menu loads best-effort; a failure here should not break the layout.
            // Errors surface on the individual task pages when the user navigates there.
            Logger.LogWarning(ex, "NavMenu: failed to load task lists");
        }
    }
}
