@using Microsoft.Identity.Web
@inject ITodoService TodoService
@inject NavigationManager NavigationManager

<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/today" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Today">Today</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/templates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContentCopy">Templates</MudNavLink>
            <MudNavLink Href="/api-keys" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VpnKey">API Keys</MudNavLink>
            <MudDivider Class="my-2" />
            @foreach (var list in _taskLists)
            {
                <MudNavLink Href="@($"/tasks/{list.Id}")" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CheckBox">@list.DisplayName</MudNavLink>
            }
            <MudNavLink Href="/sync-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SyncAlt">Sync Settings</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private IReadOnlyList<TodoTaskList> _taskLists = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _taskLists = await TodoService.GetTaskListsAsync();
        }
        catch (Exception ex) when (ex is MicrosoftIdentityWebChallengeUserException)
        {
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
        }
        catch (Exception ex)
        {
            // Nav menu loads best-effort; a failure here should not break the layout.
            // Errors surface on the individual task pages when the user navigates there.
            Console.Error.WriteLine($"NavMenu: failed to load task lists: {ex.Message}");
        }
    }
}
