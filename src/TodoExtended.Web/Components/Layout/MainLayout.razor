@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using TodoExtended.Web.Services
@inject TodoExtended.Web.Services.IUserPreferenceService UserPreferenceService
@inject IOptions<DemoOptions> DemoOptions

<div class="@(_isDarkMode ? "dark" : "") min-h-screen bg-slate-50 dark:bg-slate-950 ambient-bg dark:ambient-bg-dark">

    <AuthorizeView>
        <Authorized>
            <!-- ░░ FLOATING TOPBAR ░░ -->
            <header class="fixed top-3 left-3 right-3 z-30 h-14
                           bg-gradient-to-r from-brand-700/95 via-brand-600/95 to-violet-600/95
                           backdrop-blur-xl rounded-2xl
                           shadow-2xl shadow-brand-800/40
                           border border-white/10
                           flex items-center gap-3 px-4">

                <!-- Hamburger (mobile only) -->
                <button @onclick="ToggleSidebar"
                        class="lg:hidden p-1.5 rounded-lg text-white/80 hover:text-white hover:bg-white/15 transition-colors"
                        aria-label="Toggle menu">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>

                <!-- Logo -->
                <a href="/" class="flex items-center gap-2.5 font-extrabold text-white text-base tracking-tight select-none">
                    <div class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-sm flex items-center justify-center text-sm font-black shadow-inner">✓</div>
                    <span class="hidden sm:inline">TodoExtended</span>
                </a>

                <div class="flex-1"></div>

                <!-- User pill -->
                <div class="hidden sm:flex items-center gap-1.5 bg-white/15 backdrop-blur-sm text-white/90 text-xs font-medium rounded-full px-3 py-1.5 border border-white/10">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 10a4 4 0 100-8 4 4 0 000 8zm-7 8a7 7 0 1114 0H3z"/>
                    </svg>
                    <span>@context.User.Identity?.Name</span>
                </div>

                <!-- Dark mode toggle -->
                <button @onclick="ToggleDarkMode"
                        class="p-1.5 rounded-lg text-white/80 hover:text-white hover:bg-white/15 transition-colors"
                        aria-label="Toggle dark mode">
                    @if (_isDarkMode)
                    {
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    }
                    else
                    {
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                        </svg>
                    }
                </button>

                <!-- Sign out -->
                <a href="@(DemoOptions.Value.Enabled ? "/auth/demo-signout" : "MicrosoftIdentity/Account/SignOut")"
                   class="text-white/80 hover:text-white text-xs font-semibold transition-colors px-2.5 py-1.5 rounded-xl hover:bg-white/15 border border-white/0 hover:border-white/10">
                    Sign out
                </a>
            </header>

            <!-- ░░ MOBILE OVERLAY ░░ -->
            @if (_sidebarOpen)
            {
                <div class="fixed inset-0 z-20 bg-black/40 backdrop-blur-sm lg:hidden" @onclick="ToggleSidebar"></div>
            }

            <!-- ░░ FLOATING SIDEBAR ░░ -->
            <aside class="@(_sidebarOpen ? "translate-x-0" : "-translate-x-64") lg:translate-x-0
                          fixed top-20 left-3 bottom-3 z-20 w-60
                          bg-white/85 dark:bg-slate-900/85
                          backdrop-blur-xl
                          border border-white/80 dark:border-white/5
                          rounded-3xl
                          shadow-2xl shadow-slate-900/10 dark:shadow-slate-900/60
                          overflow-y-auto
                          transition-transform duration-200 ease-out">
                <NavMenu />
            </aside>

            <!-- ░░ MAIN CONTENT ░░ -->
            <main class="lg:pl-[252px] pt-20 min-h-screen relative z-10">
                <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
                    @Body
                </div>
            </main>

            <ToastStack />
        </Authorized>

        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isDarkMode = false;
    private bool _sidebarOpen = false;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
            if (_userId is not null)
                _isDarkMode = await UserPreferenceService.GetIsDarkModeAsync(_userId);
        }
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        if (_userId is not null)
            await UserPreferenceService.SetIsDarkModeAsync(_userId, _isDarkMode);
    }
}
