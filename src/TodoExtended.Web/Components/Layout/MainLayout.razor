@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using TodoExtended.Web.Services
@inject TodoExtended.Web.Services.IUserPreferenceService UserPreferenceService
@inject IOptions<DemoOptions> DemoOptions

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="0" Dense="true" Style="border-bottom: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(8px);">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-2" Style="font-weight: 700; letter-spacing: -0.02em;">TodoExtended</MudText>
                <MudSpacer />
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <div class="d-flex align-center mr-3" style="background: rgba(255,255,255,0.15); border-radius: 20px; padding: 4px 14px;">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                        <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                    </div>
                </MudHidden>
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleDarkMode" />
                <MudButton Href="@(DemoOptions.Value.Enabled ? "/auth/demo-signout" : "MicrosoftIdentity/Account/SignOut")" Color="Color.Inherit" Variant="Variant.Text" Style="font-weight: 500;">Sign out</MudButton>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="@DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always" Style="border-right: 1px solid var(--mud-palette-divider);">
                <NavMenu />
            </MudDrawer>

            <MudMainContent Class="pa-4 pa-sm-6" Style="margin-top: var(--mud-appbar-height);">
                <MudContainer MaxWidth="MaxWidth.Large">
                    @Body
                </MudContainer>
            </MudMainContent>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private string? _userId;

    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4F46E5",
            PrimaryDarken = "#4338CA",
            PrimaryLighten = "#818CF8",
            Secondary = "#7C3AED",
            Tertiary = "#0EA5E9",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Info = "#3B82F6",
            AppbarBackground = "#4F46E5",
            AppbarText = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1E293B",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            TextPrimary = "#0F172A",
            TextSecondary = "#64748B",
            Divider = "#E2E8F0",
            TableStriped = "#F1F5F9",
            ActionDefault = "#64748B",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818CF8",
            PrimaryDarken = "#6366F1",
            PrimaryLighten = "#A5B4FC",
            Secondary = "#A78BFA",
            Tertiary = "#38BDF8",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            Info = "#60A5FA",
            AppbarBackground = "#1E1B4B",
            AppbarText = "#E0E7FF",
            DrawerBackground = "#1E1B4B",
            DrawerText = "#C7D2FE",
            Background = "#0F172A",
            Surface = "#1E293B",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            Divider = "#334155",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Inter", "ui-sans-serif", "system-ui", "sans-serif" } },
            H4 = new H4Typography { FontWeight = "700", LetterSpacing = "-0.02em" },
            H5 = new H5Typography { FontWeight = "600", LetterSpacing = "-0.01em" },
            H6 = new H6Typography { FontWeight = "600" },
            Subtitle1 = new Subtitle1Typography { FontWeight = "500" },
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
            DrawerWidthLeft = "260px",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
            if (_userId is not null)
            {
                _isDarkMode = await UserPreferenceService.GetIsDarkModeAsync(_userId);
            }
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        if (_userId is not null)
        {
            await UserPreferenceService.SetIsDarkModeAsync(_userId, _isDarkMode);
        }
    }
}
