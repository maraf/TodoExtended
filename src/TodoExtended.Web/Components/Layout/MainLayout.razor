@inherits LayoutComponentBase

<div class="flex min-h-screen bg-gray-50 dark:bg-gray-900">
    <aside class="w-64 shrink-0 h-screen sticky top-0 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 overflow-y-auto">
        <NavMenu />
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="sticky top-0 z-10 flex items-center justify-end px-6 py-3 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
            <AuthorizeView>
                <Authorized>
                    <span class="text-sm text-gray-600 dark:text-gray-300 mr-4">Hello, @context.User.Identity?.Name</span>
                    <a href="MicrosoftIdentity/Account/SignOut" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a href="MicrosoftIdentity/Account/SignIn" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <main class="flex-1 p-6 overflow-auto">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
