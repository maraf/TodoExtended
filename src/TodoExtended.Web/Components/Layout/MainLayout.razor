@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using TodoExtended.Web.Services
@inject TodoExtended.Web.Services.IUserPreferenceService UserPreferenceService
@inject IOptions<DemoOptions> DemoOptions

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="1" Dense="true">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-2">TodoExtended</MudText>
                <MudSpacer />
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudText Typo="Typo.body2" Class="mr-2">@context.User.Identity?.Name</MudText>
                </MudHidden>
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleDarkMode" />
                <MudButton Href="MicrosoftIdentity/Account/SignOut" Color="Color.Inherit" Variant="Variant.Text">Sign out</MudButton>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="@DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
                <NavMenu />
            </MudDrawer>

            <MudMainContent Class="pa-4" Style="margin-top: var(--mud-appbar-height);">
                <MudContainer MaxWidth="MaxWidth.Large">
                    @Body
                </MudContainer>
            </MudMainContent>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private string? _userId;

    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976D2",
            Secondary = "#7C4DFF",
            Tertiary = "#00BFA5",
            AppbarBackground = "#1976D2",
            DrawerBackground = "#FAFAFA",
            Background = "#F5F5F5",
            Surface = "#FFFFFF",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#1976D2",
            Secondary = "#B388FF",
            Tertiary = "#64FFDA",
            AppbarBackground = "#1E1E1E",
            DrawerBackground = "#121212",
            Background = "#121212",
            Surface = "#1E1E1E",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" } }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;
            _userId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
            if (_userId is not null)
            {
                _isDarkMode = await UserPreferenceService.GetIsDarkModeAsync(_userId);
            }
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        if (_userId is not null)
        {
            await UserPreferenceService.SetIsDarkModeAsync(_userId, _isDarkMode);
        }
    }
}
