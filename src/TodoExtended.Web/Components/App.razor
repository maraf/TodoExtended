<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#4338ca" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="TodoExtended.Web.styles.css" />
    <link rel="icon" type="image/svg+xml" href="TodoExtended_icon.svg" />
    <link rel="manifest" href="manifest.json" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script>
        window.setDarkMode = (isDark) => document.documentElement.classList.toggle('dark', isDark);
        window.scrollToBottom = () => { const el = document.querySelector('main'); if (el) el.scrollTo({ top: el.scrollHeight, behavior: 'smooth' }); };

        // Hide the bottom bar when the soft keyboard is open.
        // Use visualViewport resize heuristic for all browsers.
        // interactive-widget=resizes-content in the viewport meta ensures the
        // visual viewport shrinks when the keyboard opens (Chrome 108+, Safari 17.4+).
        (function () {
            if (window.visualViewport) {
                var keyboardOpenThreshold = 150;
                var baseline = window.visualViewport.height;
                var lastWidth = window.visualViewport.width;
                var wasKeyboardOpen = false;
                window.visualViewport.addEventListener('resize', function () {
                    var current = window.visualViewport.height;
                    var currentWidth = window.visualViewport.width;
                    // Width change means orientation change — reset baseline and clear state.
                    if (currentWidth !== lastWidth) {
                        lastWidth = currentWidth;
                        baseline = current;
                        document.body.classList.remove('keyboard-open');
                        wasKeyboardOpen = false;
                        return;
                    }
                    var keyboardOpen = baseline - current > keyboardOpenThreshold;
                    document.body.classList.toggle('keyboard-open', keyboardOpen);
                    if (wasKeyboardOpen && !keyboardOpen && document.querySelector('.chat-input-sticky')) {
                        // Keyboard just closed on the chat page — scroll main to bottom
                        // so the sticky chat input re-aligns to its correct bottom-14 position.
                        var el = document.querySelector('main');
                        if (el) el.scrollTop = el.scrollHeight - el.clientHeight;
                    }
                    wasKeyboardOpen = keyboardOpen;
                });
                // Exposed so the reconnect modal can re-evaluate keyboard state after it closes,
                // preventing a stale keyboard-open class from removing content bottom padding.
                window.updateKeyboardState = function () {
                    var current = window.visualViewport.height;
                    var keyboardOpen = baseline - current > keyboardOpenThreshold;
                    document.body.classList.toggle('keyboard-open', keyboardOpen);
                };
            }
        })();
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
